,"2243":3,"2244":3,"2245":3,"2246":3,"2247":3,"2248":3,"2249":3,"2250":3,"2251":3,"2252":3,"2253":3,"2254":3,"2255":3,"2256":3,"2257":3,"2258":3,"2259":3,"2260":3,"2261":3,"2262":3,"2263":3,"2264":3,"2265":3,"2266":3,"2267":3,"2268":3,"2269":3,"2270":3,"2271":3,"2272":5,"2273":5,"2274":5,"2275":5,"2276":5,"2277":5,"2278":5,"2279":5,"2280":5,"2281":3,"2282":3,"2283":3,"2284":3,"2285":3,"2286":3,"2287":3,"2288":3,"2289":3,"2290":3,"2291":3,"2292":3,"2293":3,"2294":3,"2295":3,"2296":4,"2297":4,"2298":7,"2299":7,"2300":6,"2301":4,"2302":3,"2303":4,"2304":4,"2305":7,"2306":7,"2307":6,"2308":4,"2309":3,"2310":3,"2311":4,"2312":4,"2313":7,"2314":7,"2315":6,"2316":4,"2317":3,"2318":4,"2319":4,"2320":7,"2321":7,"2322":6,"2323":4,"2324":3,"2325":3,"2326":4,"2327":4,"2328":7,"2329":7,"2330":6,"2331":4,"2332":3,"2333":4,"2334":4,"2335":7,"2336":7,"2337":6,"2338":4,"2339":3,"2340":3,"2341":4,"2342":4,"2343":7,"2344":7,"2345":6,"2346":4,"2347":3,"2348":4,"2349":4,"2350":7,"2351":7,"2352":6,"2353":4,"2354":4,"2355":4,"2356":5,"2357":5,"2358":8,"2359":8,"2360":7,"2361":5,"2362":4,"2363":5,"2364":5,"2365":8,"2366":8,"2367":7,"2368":5,"2369":3,"2370":3,"2371":4,"2372":4,"2373":7,"2374":7,"2375":6,"2376":4,"2377":3,"2378":4,"2379":4,"2380":7,"2381":7,"2382":6,"2383":4,"2384":2,"2385":2,"2386":8,"2387":5,"2388":8,"2389":8,"2390":5,"2391":5}},"unstoredValues":{},"unstoredTerms":{}},"docs":{"docs":{"1":{"id":"/docs/cli","page_id":"/docs/cli","type":"page","content":"CLI","breadcrumbs":["Docs"],"tags":[],"url":"/docs/cli"},"2":{"id":"/docs/cli-0","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli","content":"Every shadcn-nsh@latest command, with its flags and defaults."},"3":{"id":"/docs/cli-1","page_id":"/docs/cli","type":"heading","tags":[],"url":"/docs/cli#init","content":"init"},"4":{"id":"/docs/cli-2","page_id":"/docs/cli","type":"heading","tags":[],"url":"/docs/cli#add","content":"add"},"5":{"id":"/docs/cli-3","page_id":"/docs/cli","type":"heading","tags":[],"url":"/docs/cli#list","content":"list"},"6":{"id":"/docs/cli-4","page_id":"/docs/cli","type":"heading","tags":[],"url":"/docs/cli#view","content":"view"},"7":{"id":"/docs/cli-5","page_id":"/docs/cli","type":"heading","tags":[],"url":"/docs/cli#diff","content":"diff"},"8":{"id":"/docs/cli-6","page_id":"/docs/cli","type":"heading","tags":[],"url":"/docs/cli#hosting-a-registry","content":"Hosting a registry"},"9":{"id":"/docs/cli-7","page_id":"/docs/cli","type":"heading","tags":[],"url":"/docs/cli#build","content":"build"},"10":{"id":"/docs/cli-8","page_id":"/docs/cli","type":"heading","tags":[],"url":"/docs/cli#serve","content":"serve"},"11":{"id":"/docs/cli-9","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli","content":"`shadcn-nsh@latest` copies registry items into an existing NSH app. The component pages use `npx shadcn-nsh@latest add <name>`; this page is the command reference."},"12":{"id":"/docs/cli-10","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli","content":"`-c, --cwd <dir>` is the app or monorepo directory (default: the current directory). `--registry <url>` is a template containing `{name}`; `add`, `list`, `view` and `diff` use the `registry` in `nsh-ui.json` when it is omitted, or the public registry at `https://raw.githubusercontent.com/aningdev/shadcn-nsh/v<version>/public/r/{name}.json` — the one published with the release your CLI came from, so the files match the CLI you are running. `init` uses that public registry. Every command takes `-h, --help`; `shadcn-nsh --version` prints the version."},"13":{"id":"/docs/cli-11","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#init","content":"Writes `nsh-ui.json`, installs the theme, points every `nsh.json` at it, and sets up the `@/` import alias in an app. Run it once in an app that already has `nsh.json`."},"14":{"id":"/docs/cli-12","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#init","content":"| Flag              | What it does               | Default               |\n| ----------------- | -------------------------- | --------------------- |\n| `-c, --cwd <cwd>` | App or monorepo directory. | The current directory |","table":"table-0"},"15":{"id":"/docs/cli-13","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#init","content":"| Flag        | What it does                                 | Default |\n| ----------- | -------------------------------------------- | ------- |\n| `-y, --yes` | Accepted for scripts; nothing prompts today. | `false` |","table":"table-0"},"16":{"id":"/docs/cli-14","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#init","content":"| Flag          | What it does                        | Default |\n| ------------- | ----------------------------------- | ------- |\n| `--overwrite` | Overwrite files that already exist. | `false` |","table":"table-0"},"17":{"id":"/docs/cli-15","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#init","content":"| Flag             | What it does                                                                                    | Default   |\n| ---------------- | ----------------------------------------------------------------------------------------------- | --------- |\n| `--theme <name>` | Theme to install: `default`, `shadcn`, `solid-glass`, `apple`, `material`, `winui` or `native`. | `default` |","table":"table-0"},"18":{"id":"/docs/cli-16","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#init","content":"| Flag               | What it does                               | Default             |\n| ------------------ | ------------------------------------------ | ------------------- |\n| `--registry <url>` | Registry URL template containing `{name}`. | The public registry |","table":"table-0"},"19":{"id":"/docs/cli-17","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#init","content":"It writes `theme.json`, `light.tokens.json`, `dark.tokens.json`, `DESIGN.md`, `lib/ui/semantics.json` and `lib/ui/theme.ts` into the app (under `packages/ui` in a monorepo), and a `tsconfig.json` when the app has none. `theme.json` and `lib/ui/semantics.json` are the theme the app is **built** with; which one they hold is recorded in `nsh-ui.json` (`\"theme\": \"theme\"`, or `\"theme-shadcn\"` for `--theme shadcn`), and `add` resolves a component's `theme` dependency to it, so taking a component later — `--overwrite` included — never writes the default theme back. `light.tokens.json` and `dark.tokens.json` are standalone DTCG 2025.10 files describing the shipped theme for design tools (Figma Variables Light/Dark modes, Tokens Studio, Style Dictionary v4), `DESIGN.md` gives coding agents the theme's tokens and design rationale, and none of these generated snapshots follow later edits to `theme.json`. `--theme shadcn` also writes `themes/shadcn/`, the same palette as a theme the app can switch to while it runs."},"20":{"id":"/docs/cli-18","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#init","content":"In an app, `init` also sets up the `@/` import alias the docs' snippets use (`@/components/ui/<name>`, `@/lib/ui/theme`): `tsconfig.json` gains `\"@/*\": [\"./*\"]` under `compilerOptions.paths` — restating the NSH mappings `.nsh/tsconfig.json` declares, because a child's `paths` replace the base's — and `nsh.json` gains `\"resolve\": { \"alias\": { \"@\": \"./\" } }` for `nsh run`/`build`/`test`, which read `nsh.json`, not tsconfig. Values it finds already there are left alone with a warning. A monorepo imports from `@workspace/ui` instead, so it is not touched."},"21":{"id":"/docs/cli-19","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#init","content":"If `nsh.json` names `tailwind.colors`, `init` ends with one line naming the theme tokens those colors shadow — a class takes the Tailwind color while `token()` and the theme take the theme's (Override from `nsh.json`). It is a warning: the command never fails over it, and `add` prints the same line."},"22":{"id":"/docs/cli-20","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#add","content":"Copies items and their `registryDependencies` into the app, dependencies first."},"23":{"id":"/docs/cli-21","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#add","content":"Name at least one item, or pass `--all`."},"24":{"id":"/docs/cli-22","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#add","content":"| Flag              | What it does               | Default               |\n| ----------------- | -------------------------- | --------------------- |\n| `-c, --cwd <cwd>` | App or monorepo directory. | The current directory |","table":"table-1"},"25":{"id":"/docs/cli-23","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#add","content":"| Flag              | What it does                       | Default |\n| ----------------- | ---------------------------------- | ------- |\n| `-o, --overwrite` | Replace files the app has changed. | `false` |","table":"table-1"},"26":{"id":"/docs/cli-24","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#add","content":"| Flag        | What it does                                 | Default |\n| ----------- | -------------------------------------------- | ------- |\n| `-a, --all` | Every `registry:ui` item the registry lists. | `false` |","table":"table-1"},"27":{"id":"/docs/cli-25","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#add","content":"| Flag        | What it does                                | Default |\n| ----------- | ------------------------------------------- | ------- |\n| `--dry-run` | Print what would be written; write nothing. | `false` |","table":"table-1"},"28":{"id":"/docs/cli-26","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#add","content":"| Flag               | What it does                               | Default                                       |\n| ------------------ | ------------------------------------------ | --------------------------------------------- |\n| `--registry <url>` | Registry URL template containing `{name}`. | `nsh-ui.json`'s registry, else the public one |","table":"table-1"},"29":{"id":"/docs/cli-27","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#add","content":"A file the app lacks is written, one identical to the registry's is skipped, and one the app changed is kept unless `--overwrite`. Without `--overwrite`, `theme.json` and `lib/ui/semantics.json` gain only the keys they lack (keeping the app's own colors, style values and finishes). `theme` — named, or the dependency every component has — is the theme `nsh-ui.json` records, so in an app on `theme-shadcn`, `add theme --overwrite` writes shadcn's data back, not the default one's."},"30":{"id":"/docs/cli-28","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#add","content":"The packages the items import (`lucide`) are installed with the app's own package manager, unless its `package.json` already declares them at a version in range: an exact `\"lucide\": \"1.66.0\"` is left as written."},"31":{"id":"/docs/cli-29","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#add","content":"Naming a theme (`add theme-shadcn`) installs **one more**: `themes/shadcn/`, a theme the app can switch to while it runs (`selectTheme`), with its own `theme.json`, `semantics.json`, `light.tokens.json`, `dark.tokens.json`, `DESIGN.md` and `index.ts`. It writes nothing over the app's build-time theme, and `nsh-ui.json` stays as it is; that theme is `init --theme <name> --overwrite`."},"32":{"id":"/docs/cli-30","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#list","content":"Lists the registry's items, marking the ones the app has."},"33":{"id":"/docs/cli-31","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#list","content":"| Flag              | What it does               | Default               |\n| ----------------- | -------------------------- | --------------------- |\n| `-c, --cwd <cwd>` | App or monorepo directory. | The current directory |","table":"table-2"},"34":{"id":"/docs/cli-32","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#list","content":"| Flag     | What it does               | Default |\n| -------- | -------------------------- | ------- |\n| `--json` | Print the catalog as JSON. | `false` |","table":"table-2"},"35":{"id":"/docs/cli-33","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#list","content":"| Flag               | What it does                               | Default                                       |\n| ------------------ | ------------------------------------------ | --------------------------------------------- |\n| `--registry <url>` | Registry URL template containing `{name}`. | `nsh-ui.json`'s registry, else the public one |","table":"table-2"},"36":{"id":"/docs/cli-34","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#list","content":"`✓` marks an item when any of its files is in the app; the last line counts the items and the installed ones."},"37":{"id":"/docs/cli-35","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#view","content":"Prints the files `add` would write, dependencies first, at their target paths and with imports rewritten for the app. Writes nothing."},"38":{"id":"/docs/cli-36","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#view","content":"| Flag              | What it does               | Default               |\n| ----------------- | -------------------------- | --------------------- |\n| `-c, --cwd <cwd>` | App or monorepo directory. | The current directory |","table":"table-3"},"39":{"id":"/docs/cli-37","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#view","content":"| Flag               | What it does                               | Default                                       |\n| ------------------ | ------------------------------------------ | --------------------------------------------- |\n| `--registry <url>` | Registry URL template containing `{name}`. | `nsh-ui.json`'s registry, else the public one |","table":"table-3"},"40":{"id":"/docs/cli-38","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#diff","content":"Compares the app's installed files with the registry's. Exits `1` when they differ, `2` when it could not compare."},"41":{"id":"/docs/cli-39","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#diff","content":"| Flag              | What it does               | Default               |\n| ----------------- | -------------------------- | --------------------- |\n| `-c, --cwd <cwd>` | App or monorepo directory. | The current directory |","table":"table-4"},"42":{"id":"/docs/cli-40","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#diff","content":"| Flag               | What it does                               | Default                                       |\n| ------------------ | ------------------------------------------ | --------------------------------------------- |\n| `--registry <url>` | Registry URL template containing `{name}`. | `nsh-ui.json`'s registry, else the public one |","table":"table-4"},"43":{"id":"/docs/cli-41","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#diff","content":"Without an item it lists the installed items that differ; with one it prints the changed lines. `-` is a line of the app's file that overwriting would drop, `+` one it would add. A recolored `theme.json` or customized `semantics.json` is not a difference; a missing key is."},"44":{"id":"/docs/cli-42","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#diff","content":"| Exit | Meaning         |\n| ---- | --------------- |\n| `0`  | No differences. |","table":"table-5"},"45":{"id":"/docs/cli-43","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#diff","content":"| Exit | Meaning                                           |\n| ---- | ------------------------------------------------- |\n| `1`  | Something differs (or there is no `nsh-ui.json`). |","table":"table-5"},"46":{"id":"/docs/cli-44","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#diff","content":"| Exit | Meaning                                                                 |\n| ---- | ----------------------------------------------------------------------- |\n| `2`  | The registry cannot be reached and nothing is cached: compared nothing. |","table":"table-5"},"47":{"id":"/docs/cli-45","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#diff","content":"Every registry file the CLI fetches over HTTP is kept in `~/.cache/shadcn-nsh` (`$XDG_CACHE_HOME`, or `SHADCN_NSH_CACHE_DIR` when set). Offline, `diff` compares with those copies and says when they were fetched; the public registry's URL is pinned to the CLI's release, so they are that registry exactly. With no copy, it prints `diff skipped` and exits `2`, so a check can tell \"could not check\" from \"differs\":"},"48":{"id":"/docs/cli-46","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#hosting-a-registry","content":"The public registry is `registry.json` built into `public/r` and served from GitHub. To host your own, build the same files and pass its URL to `--registry`."},"49":{"id":"/docs/cli-47","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#hosting-a-registry","content":"This repository has both steps as scripts: `bun run registry:build` and `bun run registry:serve`."},"50":{"id":"/docs/cli-48","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#build","content":"Builds a registry into one JSON per item plus the `index.json` that `list` and `add --all` read."},"51":{"id":"/docs/cli-49","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#build","content":"The argument is the registry file (default `./registry.json`). It fails when an item's `registryDependencies` disagree with its imports."},"52":{"id":"/docs/cli-50","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#build","content":"| Flag                  | What it does      | Default      |\n| --------------------- | ----------------- | ------------ |\n| `-o, --output <path>` | Output directory. | `./public/r` |","table":"table-6"},"53":{"id":"/docs/cli-51","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#build","content":"| Flag              | What it does       | Default               |\n| ----------------- | ------------------ | --------------------- |\n| `-c, --cwd <cwd>` | Working directory. | The current directory |","table":"table-6"},"54":{"id":"/docs/cli-52","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#serve","content":"Serves the built registry over HTTP at `127.0.0.1` for local testing."},"55":{"id":"/docs/cli-53","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#serve","content":"| Flag                | What it does | Default |\n| ------------------- | ------------ | ------- |\n| `-p, --port <port>` | Port.        | `4173`  |","table":"table-7"},"56":{"id":"/docs/cli-54","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#serve","content":"| Flag               | What it does        | Default      |\n| ------------------ | ------------------- | ------------ |\n| `-d, --dir <path>` | Registry directory. | `./public/r` |","table":"table-7"},"57":{"id":"/docs/cli-55","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#serve","content":"| Flag              | What it does       | Default               |\n| ----------------- | ------------------ | --------------------- |\n| `-c, --cwd <cwd>` | Working directory. | The current directory |","table":"table-7"},"58":{"id":"/docs/cli-56","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#serve","content":"`serve` prints the `--registry` URL to use."},"59":{"id":"/docs/components/accordion","page_id":"/docs/components/accordion","type":"page","content":"Accordion","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/accordion"},"60":{"id":"/docs/components/accordion-0","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion","content":"List rows that reveal panels with a turning chevron."},"61":{"id":"/docs/components/accordion-1","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#installation","content":"Installation"},"62":{"id":"/docs/components/accordion-2","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#usage","content":"Usage"},"63":{"id":"/docs/components/accordion-3","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#composition","content":"Composition"},"64":{"id":"/docs/components/accordion-4","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#examples","content":"Examples"},"65":{"id":"/docs/components/accordion-5","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#disabled-row","content":"Disabled row"},"66":{"id":"/docs/components/accordion-6","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#a-trigger-of-its-own","content":"A trigger of its own"},"67":{"id":"/docs/components/accordion-7","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#revealed-panel","content":"Revealed panel"},"68":{"id":"/docs/components/accordion-8","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#controlled","content":"Controlled"},"69":{"id":"/docs/components/accordion-9","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#api","content":"API"},"70":{"id":"/docs/components/accordion-10","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#composition","content":"Use the following composition to build an `Accordion`:"},"71":{"id":"/docs/components/accordion-11","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#a-trigger-of-its-own","content":"The trigger takes more than one child: what you draw is laid out in the row before the chevron, in\none line, and the chevron stays at the end (it is the part that turns as the item opens)."},"72":{"id":"/docs/components/accordion-12","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#a-trigger-of-its-own","content":"`disabled` on the trigger takes the row's presses itself — for a row that is not an item's own (an\nitem's `disabled` already does that for the header's trigger)."},"73":{"id":"/docs/components/accordion-13","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#revealed-panel","content":"`reveal` defaults on; `start` lines the panel up past a leading icon in the trigger, and `end` keeps the same room after the content."},"74":{"id":"/docs/components/accordion-14","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#controlled","content":"`value` is the open items; `onChange` reports the next list."},"75":{"id":"/docs/components/accordion-15","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#api","content":"Uses `disclosureTriggerLook`, `DisclosureChevron`, and `disclosurePanel`. Every prop of `nsh/base` Accordion parts passes through."},"76":{"id":"/docs/components/accordion-16","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#api","content":"| Part        | Props | Description         |\n| ----------- | ----- | ------------------- |\n| `Accordion` | —     | The stack of items. |","table":"table-0"},"77":{"id":"/docs/components/accordion-17","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#api","content":"| Part              | Props | Description                     |\n| ----------------- | ----- | ------------------------------- |\n| `AccordionHeader` | —     | The heading around the trigger. |","table":"table-0"},"78":{"id":"/docs/components/accordion-18","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#api","content":"| Part            | Props | Description  |\n| --------------- | ----- | ------------ |\n| `AccordionItem` | —     | One section. |","table":"table-0"},"79":{"id":"/docs/components/accordion-19","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#api","content":"| Part             | Props                                           | Description                                     |\n| ---------------- | ----------------------------------------------- | ----------------------------------------------- |\n| `AccordionPanel` | `reveal` (on by default), `start`, `end`, `gap` | Revealed content, in `disclosurePanel` padding. |","table":"table-0"},"80":{"id":"/docs/components/accordion-20","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#api","content":"| Part               | Props                        | Description                                                 |\n| ------------------ | ---------------------------- | ----------------------------------------------------------- |\n| `AccordionTrigger` | `first`, `start`, `disabled` | The title row, with a chevron that turns as the item opens. |","table":"table-0"},"81":{"id":"/docs/components/alert-dialog","page_id":"/docs/components/alert-dialog","type":"page","content":"Alert Dialog","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/alert-dialog"},"82":{"id":"/docs/components/alert-dialog-0","page_id":"/docs/components/alert-dialog","tags":[],"type":"text","url":"/docs/components/alert-dialog","content":"A confirmation of the platform's own."},"83":{"id":"/docs/components/alert-dialog-1","page_id":"/docs/components/alert-dialog","type":"heading","tags":[],"url":"/docs/components/alert-dialog#installation","content":"Installation"},"84":{"id":"/docs/components/alert-dialog-2","page_id":"/docs/components/alert-dialog","type":"heading","tags":[],"url":"/docs/components/alert-dialog#usage","content":"Usage"},"85":{"id":"/docs/components/alert-dialog-3","page_id":"/docs/components/alert-dialog","type":"heading","tags":[],"url":"/docs/components/alert-dialog#composition","content":"Composition"},"86":{"id":"/docs/components/alert-dialog-4","page_id":"/docs/components/alert-dialog","type":"heading","tags":[],"url":"/docs/components/alert-dialog#examples","content":"Examples"},"87":{"id":"/docs/components/alert-dialog-5","page_id":"/docs/components/alert-dialog","type":"heading","tags":[],"url":"/docs/components/alert-dialog#against-dialog","content":"Against `Dialog`"},"88":{"id":"/docs/components/alert-dialog-6","page_id":"/docs/components/alert-dialog","type":"heading","tags":[],"url":"/docs/components/alert-dialog#roles","content":"Roles"},"89":{"id":"/docs/components/alert-dialog-7","page_id":"/docs/components/alert-dialog","type":"heading","tags":[],"url":"/docs/components/alert-dialog#the-chosen-action","content":"The chosen action"},"90":{"id":"/docs/components/alert-dialog-8","page_id":"/docs/components/alert-dialog","type":"heading","tags":[],"url":"/docs/components/alert-dialog#awaiting-the-answer","content":"Awaiting the answer"},"91":{"id":"/docs/components/alert-dialog-9","page_id":"/docs/components/alert-dialog","type":"heading","tags":[],"url":"/docs/components/alert-dialog#action-sheet","content":"Action sheet"},"92":{"id":"/docs/components/alert-dialog-10","page_id":"/docs/components/alert-dialog","type":"heading","tags":[],"url":"/docs/components/alert-dialog#trigger","content":"Trigger"},"93":{"id":"/docs/components/alert-dialog-11","page_id":"/docs/components/alert-dialog","type":"heading","tags":[],"url":"/docs/components/alert-dialog#controlled","content":"Controlled"},"94":{"id":"/docs/components/alert-dialog-12","page_id":"/docs/components/alert-dialog","type":"heading","tags":[],"url":"/docs/components/alert-dialog#api","content":"API"},"95":{"id":"/docs/components/alert-dialog-13","page_id":"/docs/components/alert-dialog","tags":[],"type":"text","url":"/docs/components/alert-dialog#usage","content":"The box is the platform's own (`nsh/base`'s `AlertDialog.show`): UIAlertController on iOS, NSAlert\non macOS, NSH's drawing of the same box on the web, the platform dialog on Android. The parts only\nfill it in — they register a title, a message and buttons, and `AlertDialogContent` shows it when\nthe root is open. So the box **does not follow this library's theme**, what it shows is **text\nonly** (no views, icons or fields), and an Android alert takes **at most three buttons**. The\nplatform shows one box at a time, so a process has one: two `AlertDialog`s opened together share\nit, and the second is not stacked on the first."},"96":{"id":"/docs/components/alert-dialog-14","page_id":"/docs/components/alert-dialog","tags":[],"type":"text","url":"/docs/components/alert-dialog#composition","content":"Use the following composition to build an `AlertDialog`:"},"97":{"id":"/docs/components/alert-dialog-15","page_id":"/docs/components/alert-dialog","tags":[],"type":"text","url":"/docs/components/alert-dialog#against-dialog","content":"`AlertDialog` asks one question and waits for the answer; `Dialog` is the app's own card."},"98":{"id":"/docs/components/alert-dialog-16","page_id":"/docs/components/alert-dialog","tags":[],"type":"text","url":"/docs/components/alert-dialog#against-dialog","content":"|              | `AlertDialog` | `Dialog`                                  |\n| ------------ | ------------- | ----------------------------------------- |\n| Who draws it | the platform  | the app, with `dialogCard` and `backdrop` |","table":"table-0"},"99":{"id":"/docs/components/alert-dialog-17","page_id":"/docs/components/alert-dialog","tags":[],"type":"text","url":"/docs/components/alert-dialog#against-dialog","content":"|               | `AlertDialog`               | `Dialog`                              |\n| ------------- | --------------------------- | ------------------------------------- |\n| What it holds | a title, a message, buttons | any content (fields, lists, pictures) |","table":"table-0"},"100":{"id":"/docs/components/alert-dialog-18","page_id":"/docs/components/alert-dialog","tags":[],"type":"text","url":"/docs/components/alert-dialog#against-dialog","content":"|                          | `AlertDialog` | `Dialog` |\n| ------------------------ | ------------- | -------- |\n| Does it follow the theme | no            | yes      |","table":"table-0"},"101":{"id":"/docs/components/alert-dialog-19","page_id":"/docs/components/alert-dialog","tags":[],"type":"text","url":"/docs/components/alert-dialog#against-dialog","content":"|                            | `AlertDialog`          | `Dialog` |\n| -------------------------- | ---------------------- | -------- |\n| Escape, backdrop and swipe | off (`closeOn*` props) | on       |","table":"table-0"},"102":{"id":"/docs/components/alert-dialog-20","page_id":"/docs/components/alert-dialog","tags":[],"type":"text","url":"/docs/components/alert-dialog#against-dialog","content":"Use `Dialog` when the box needs content of the app's own or the app's look; use `AlertDialog` when\nit is a yes/no question the system should ask."},"103":{"id":"/docs/components/alert-dialog-21","page_id":"/docs/components/alert-dialog","tags":[],"type":"text","url":"/docs/components/alert-dialog#roles","content":"`role` is what each button means, and the platform places and draws it by that: `cancel` on its\nown, `destructive` in red where the platform has red."},"104":{"id":"/docs/components/alert-dialog-22","page_id":"/docs/components/alert-dialog","tags":[],"type":"text","url":"/docs/components/alert-dialog#roles","content":"`AlertDialogCancel` is the same button with `role=\"cancel\"`; its `id` is `\"cancel\"` unless named."},"105":{"id":"/docs/components/alert-dialog-23","page_id":"/docs/components/alert-dialog","tags":[],"type":"text","url":"/docs/components/alert-dialog#the-chosen-action","content":"`onAction` reports the `id` of the button pressed (the app's name for it, never the label), or\n`null` when the box closed without one."},"106":{"id":"/docs/components/alert-dialog-24","page_id":"/docs/components/alert-dialog","tags":[],"type":"text","url":"/docs/components/alert-dialog#awaiting-the-answer","content":"An app that wants the choice before it draws anything else — `await`, then act — shows the same box\nwith `nsh/base`'s own `AlertDialog.show`, which resolves with `{ action }`. That is the app's call.\nThe parts above declare a box under a root of the page's, for an alert that is part of what the page\ndraws; the library has no imperative `show` of its own: a web alert is\nalways the app's own drawing, and a second way in would be two APIs for one box."},"107":{"id":"/docs/components/alert-dialog-25","page_id":"/docs/components/alert-dialog","tags":[],"type":"text","url":"/docs/components/alert-dialog#action-sheet","content":"`presentation=\"actionSheet\"` slides the box up from the bottom (a list on Android). Escape and a\npress outside close it unless `closeOnEscape` / `closeOnBackdropPress` say otherwise; an alert\n(`\"alert\"`, the default) waits for a button."},"108":{"id":"/docs/components/alert-dialog-26","page_id":"/docs/components/alert-dialog","tags":[],"type":"text","url":"/docs/components/alert-dialog#trigger","content":"A string child is a `Button`; `variant` picks its look (`secondary` by default). Anything else is\ndrawn as given."},"109":{"id":"/docs/components/alert-dialog-27","page_id":"/docs/components/alert-dialog","tags":[],"type":"text","url":"/docs/components/alert-dialog#controlled","content":"`open` shows the box and `onOpenChange` reports every change of it — `reason` is `\"triggerPress\"`\nwhen the trigger opened it, `\"select\"` when a button was chosen and `\"cancel\"` when it closed\nwithout one."},"110":{"id":"/docs/components/alert-dialog-28","page_id":"/docs/components/alert-dialog","tags":[],"type":"text","url":"/docs/components/alert-dialog#api","content":"`AlertDialog` owns the open state and the text its parts registered; `AlertDialogContent` calls\n`nsh/base` `AlertDialog.show` when it opens. The box stays\none while it is up: a part that renders again with the alert still open — a page whose layout\nrebuilds its children does — stacks nothing, and the answer belongs to the app that asked."},"111":{"id":"/docs/components/alert-dialog-29","page_id":"/docs/components/alert-dialog","tags":[],"type":"text","url":"/docs/components/alert-dialog#api","content":"| Part          | Props                                                                           | Description                                                      |\n| ------------- | ------------------------------------------------------------------------------- | ---------------------------------------------------------------- |\n| `AlertDialog` | `open`, `defaultOpen`, `onOpenChange({ open, reason })`, `onAction({ action })` | The root: owns the open state and the text its parts registered. |","table":"table-1"},"112":{"id":"/docs/components/alert-dialog-30","page_id":"/docs/components/alert-dialog","tags":[],"type":"text","url":"/docs/components/alert-dialog#api","content":"| Part                 | Props                                                                                         | Description                                                                                                 |\n| -------------------- | --------------------------------------------------------------------------------------------- | ----------------------------------------------------------------------------------------------------------- |\n| `AlertDialogTrigger` | `Action`'s props — `children`, `variant`, `disabled`, and every view prop — without `onPress` | The press that opens it; a string child is a `Button`, `variant` picking its look (`secondary` by default). |","table":"table-1"},"113":{"id":"/docs/components/alert-dialog-31","page_id":"/docs/components/alert-dialog","tags":[],"type":"text","url":"/docs/components/alert-dialog#api","content":"| Part                 | Props                                                                                      | Description                                                                   |\n| -------------------- | ------------------------------------------------------------------------------------------ | ----------------------------------------------------------------------------- |\n| `AlertDialogContent` | `presentation`, `closeOnEscape`, `closeOnBackdropPress` — the rest of `AlertDialogOptions` | The parts the box shows, and the `AlertDialog.show` call when the root opens. |","table":"table-1"},"114":{"id":"/docs/components/alert-dialog-32","page_id":"/docs/components/alert-dialog","tags":[],"type":"text","url":"/docs/components/alert-dialog#api","content":"| Part               | Props                 | Description  |\n| ------------------ | --------------------- | ------------ |\n| `AlertDialogTitle` | `children` (a string) | The heading. |","table":"table-1"},"115":{"id":"/docs/components/alert-dialog-33","page_id":"/docs/components/alert-dialog","tags":[],"type":"text","url":"/docs/components/alert-dialog#api","content":"| Part                     | Props                 | Description  |\n| ------------------------ | --------------------- | ------------ |\n| `AlertDialogDescription` | `children` (a string) | The message. |","table":"table-1"},"116":{"id":"/docs/components/alert-dialog-34","page_id":"/docs/components/alert-dialog","tags":[],"type":"text","url":"/docs/components/alert-dialog#api","content":"| Part                | Props                                                       | Description                                                        |\n| ------------------- | ----------------------------------------------------------- | ------------------------------------------------------------------ |\n| `AlertDialogAction` | `id`, `role`, `children` (a string; the `id` when left out) | A choice; `role` is what it means and `onAction` reports its `id`. |","table":"table-1"},"117":{"id":"/docs/components/alert-dialog-35","page_id":"/docs/components/alert-dialog","tags":[],"type":"text","url":"/docs/components/alert-dialog#api","content":"| Part                | Props                                 | Description                           |\n| ------------------- | ------------------------------------- | ------------------------------------- |\n| `AlertDialogCancel` | `id` (default `\"cancel\"`), `children` | The same button with `role=\"cancel\"`. |","table":"table-1"},"118":{"id":"/docs/components/alert-dialog-36","page_id":"/docs/components/alert-dialog","tags":[],"type":"text","url":"/docs/components/alert-dialog#api","content":"| Part                | Props      | Description                 |\n| ------------------- | ---------- | --------------------------- |\n| `AlertDialogHeader` | `children` | A group that draws nothing. |","table":"table-1"},"119":{"id":"/docs/components/alert-dialog-37","page_id":"/docs/components/alert-dialog","tags":[],"type":"text","url":"/docs/components/alert-dialog#api","content":"| Part                | Props      | Description                                                                 |\n| ------------------- | ---------- | --------------------------------------------------------------------------- |\n| `AlertDialogFooter` | `children` | A group that draws nothing; the buttons keep the order they are written in. |","table":"table-1"},"120":{"id":"/docs/components/alert","page_id":"/docs/components/alert","type":"page","content":"Alert","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/alert"},"121":{"id":"/docs/components/alert-0","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert","content":"A notice of the whole page or form, read out when it appears."},"122":{"id":"/docs/components/alert-1","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#installation","content":"Installation"},"123":{"id":"/docs/components/alert-2","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#usage","content":"Usage"},"124":{"id":"/docs/components/alert-3","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#composition","content":"Composition"},"125":{"id":"/docs/components/alert-4","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#examples","content":"Examples"},"126":{"id":"/docs/components/alert-5","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#with-an-icon-and-a-note","content":"With an icon and a note"},"127":{"id":"/docs/components/alert-6","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#a-title-and-no-note","content":"A title and no note"},"128":{"id":"/docs/components/alert-7","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#destructive","content":"Destructive"},"129":{"id":"/docs/components/alert-8","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#a-note-and-no-title","content":"A note and no title"},"130":{"id":"/docs/components/alert-9","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#a-note-of-the-apps-own","content":"A note of the app's own"},"131":{"id":"/docs/components/alert-10","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#the-icons-column","content":"The icon's column"},"132":{"id":"/docs/components/alert-11","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#how-it-differs-from-the-other-alerts","content":"How it differs from the other alerts"},"133":{"id":"/docs/components/alert-12","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#api","content":"API"},"134":{"id":"/docs/components/alert-13","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#usage","content":"The examples draw icons with `Icon` from `lib/ui/icons`; see Icons for adding it and picking a size and color."},"135":{"id":"/docs/components/alert-14","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#composition","content":"Use the following composition to build an `Alert`:"},"136":{"id":"/docs/components/alert-15","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#with-an-icon-and-a-note","content":"The icon comes first, drawn at `ALERT_ICON` (16 points) in the notice's ink — the terminal draws\nno icons, and there the notice is its text. The title and the note line up in the column beside\nit, the note a step quieter than the title."},"137":{"id":"/docs/components/alert-16","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#a-title-and-no-note","content":"An icon and a title are a notice of one line."},"138":{"id":"/docs/components/alert-17","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#destructive","content":"`variant=\"destructive\"` puts the whole notice in the danger tone: the title and the icon on it,\nthe note at nine tenths. The parts under the root wear it without being told — the root hands the\nvariant down."},"139":{"id":"/docs/components/alert-18","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#a-note-and-no-title","content":"The note has a column and no row of its own: with no title it sits beside the icon,\nand a long sentence wraps there. Put an error that needs more than one line in the note, not in\nthe title, which keeps to one line."},"140":{"id":"/docs/components/alert-19","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#a-note-of-the-apps-own","content":"`AlertDescription` is a frame, not a sentence: a string is drawn in the note's type and ink, and\nanything else is laid out as given — a column of lines, a link, a row of buttons. What the app puts\nthere carries its own ink."},"141":{"id":"/docs/components/alert-20","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#the-icons-column","content":"A view has no selector for its children, and a child cannot be asked what it is, so the text keeps\nthat gutter either way: an alert without an icon starts 12 points in from its padding. Write the\nicon first — it is what takes the leading column."},"142":{"id":"/docs/components/alert-21","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#how-it-differs-from-the-other-alerts","content":"Three things are called an alert here, and this is the quiet one:"},"143":{"id":"/docs/components/alert-22","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#how-it-differs-from-the-other-alerts","content":"**this `Alert`** is a notice drawn on the page or in a form, in the app's own surface, read out by\nits `role=\"alert\"`. It takes no presses and asks nothing: the page stays usable under it."},"144":{"id":"/docs/components/alert-23","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#how-it-differs-from-the-other-alerts","content":"**`nsh/base`'s `AlertDialog`** is the platform's own alert or action sheet\n(`AlertDialog.show(options)`): a system box over the app that asks for an answer and resolves with\nthe action chosen. It looks like the operating system, not like the app."},"145":{"id":"/docs/components/alert-24","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#how-it-differs-from-the-other-alerts","content":"**this library's `alert-dialog`** is the same question in `Trigger`, `Title`, `Description`,\n`Footer` and `Action`: parts that fill in that system box, so it is the platform's — its look is\nthe operating system's and its content is strings. A confirmation card the app draws itself,\nwith the app's look and content of its own, is `dialog`."},"146":{"id":"/docs/components/alert-25","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#how-it-differs-from-the-other-alerts","content":"So: a notice that can wait belongs here; a question that must be answered before anything else is\nan `alert-dialog` (or `dialog`, when the box needs content of the app's own)."},"147":{"id":"/docs/components/alert-26","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#api","content":"Every prop of `nsh` View passes through on `Alert` and\n`AlertDescription`, and every prop of `nsh` Text on `AlertTitle`;\n`style` goes over the look's on each. The root is `role=\"alert\"`, so a notice is read out when it\nappears."},"148":{"id":"/docs/components/alert-27","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#api","content":"| Part    | Props                                                         | Description                                 |\n| ------- | ------------------------------------------------------------- | ------------------------------------------- |\n| `Alert` | `variant`: `\"default\" \\| \"destructive\"` (default `\"default\"`) | The notice's surface: `alertLook().root()`. |","table":"table-0"},"149":{"id":"/docs/components/alert-28","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#api","content":"| Part         | Props | Description                                          |\n| ------------ | ----- | ---------------------------------------------------- |\n| `AlertTitle` | —     | The title, a `Text` in `alertLook().title(variant)`. |","table":"table-0"},"150":{"id":"/docs/components/alert-29","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#api","content":"| Part               | Props | Description                                                                                          |\n| ------------------ | ----- | ---------------------------------------------------------------------------------------------------- |\n| `AlertDescription` | —     | The note: `alertLook().descriptionFrame()`, its string child `alertLook().descriptionText(variant)`. |","table":"table-0"},"151":{"id":"/docs/components/alert-30","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#api","content":"| Prop      | Type                         | Default   |\n| --------- | ---------------------------- | --------- |\n| `variant` | `\"default\" \\| \"destructive\"` | `default` |","table":"table-1"},"152":{"id":"/docs/components/alert-31","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#api","content":"The surface is the card's, with one hairline edge and the theme's inset corners, padded 16 by 12;\nthe icon's column is as wide as the icon, the text's takes the rest, a gap of 12 between them.\n`alertLook()` is exported for a notice the app draws itself, and `ALERT_ICON` is the size its icon\nis drawn at."},"153":{"id":"/docs/components/aspect-ratio","page_id":"/docs/components/aspect-ratio","type":"page","content":"Aspect ratio","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/aspect-ratio"},"154":{"id":"/docs/components/aspect-ratio-0","page_id":"/docs/components/aspect-ratio","tags":[],"type":"text","url":"/docs/components/aspect-ratio","content":"A box as wide as its column and as tall as its ratio says."},"155":{"id":"/docs/components/aspect-ratio-1","page_id":"/docs/components/aspect-ratio","type":"heading","tags":[],"url":"/docs/components/aspect-ratio#installation","content":"Installation"},"156":{"id":"/docs/components/aspect-ratio-2","page_id":"/docs/components/aspect-ratio","type":"heading","tags":[],"url":"/docs/components/aspect-ratio#usage","content":"Usage"},"157":{"id":"/docs/components/aspect-ratio-3","page_id":"/docs/components/aspect-ratio","type":"heading","tags":[],"url":"/docs/components/aspect-ratio#examples","content":"Examples"},"158":{"id":"/docs/components/aspect-ratio-4","page_id":"/docs/components/aspect-ratio","type":"heading","tags":[],"url":"/docs/components/aspect-ratio#a-picture-that-keeps-its-shape","content":"A picture that keeps its shape"},"159":{"id":"/docs/components/aspect-ratio-5","page_id":"/docs/components/aspect-ratio","type":"heading","tags":[],"url":"/docs/components/aspect-ratio#a-square","content":"A square"},"160":{"id":"/docs/components/aspect-ratio-6","page_id":"/docs/components/aspect-ratio","type":"heading","tags":[],"url":"/docs/components/aspect-ratio#a-ratio-written-as-css-does","content":"A ratio written as CSS does"},"161":{"id":"/docs/components/aspect-ratio-7","page_id":"/docs/components/aspect-ratio","type":"heading","tags":[],"url":"/docs/components/aspect-ratio#a-color-block","content":"A color block"},"162":{"id":"/docs/components/aspect-ratio-8","page_id":"/docs/components/aspect-ratio","type":"heading","tags":[],"url":"/docs/components/aspect-ratio#api","content":"API"},"163":{"id":"/docs/components/aspect-ratio-9","page_id":"/docs/components/aspect-ratio","tags":[],"type":"text","url":"/docs/components/aspect-ratio#a-picture-that-keeps-its-shape","content":"The box takes its column's width and the ratio's height; its content fills it."},"164":{"id":"/docs/components/aspect-ratio-10","page_id":"/docs/components/aspect-ratio","tags":[],"type":"text","url":"/docs/components/aspect-ratio#a-square","content":"`ratio={1}` is a square: an avatar, a swatch, a cover cut to the same width and height."},"165":{"id":"/docs/components/aspect-ratio-11","page_id":"/docs/components/aspect-ratio","tags":[],"type":"text","url":"/docs/components/aspect-ratio#a-ratio-written-as-css-does","content":"A number (`16 / 9`) or CSS's own ratio (`\"16 / 9\"`) say the same; `\"auto\"` lets the height follow\nthe content instead."},"166":{"id":"/docs/components/aspect-ratio-12","page_id":"/docs/components/aspect-ratio","tags":[],"type":"text","url":"/docs/components/aspect-ratio#a-color-block","content":"The content is anything: a chart, a placeholder, a block's fill with its label centered. A `style`\nof your own goes over the look's, so the fill and the corners are the caller's."},"167":{"id":"/docs/components/aspect-ratio-13","page_id":"/docs/components/aspect-ratio","tags":[],"type":"text","url":"/docs/components/aspect-ratio#api","content":"Every prop of `nsh` View passes through (`style`, `accessibilityLabel`, `onPress`, …); `style` goes over the look's, so a caller's own width, corners or fill replace the look's and the box keeps its ratio inside them."},"168":{"id":"/docs/components/aspect-ratio-14","page_id":"/docs/components/aspect-ratio","tags":[],"type":"text","url":"/docs/components/aspect-ratio#api","content":"| Part          | Props                                                                                               | Description                                                |\n| ------------- | --------------------------------------------------------------------------------------------------- | ---------------------------------------------------------- |\n| `AspectRatio` | `ratio`: `number`, a ratio string (`\"16 / 9\"`) or `\"auto\"` (default `1`); `children`: `JSX.Element` | A box as wide as its column and as tall as its ratio says. |","table":"table-0"},"169":{"id":"/docs/components/aspect-ratio-15","page_id":"/docs/components/aspect-ratio","tags":[],"type":"text","url":"/docs/components/aspect-ratio#api","content":"The box is as wide as its column (`width: \"100%\"`) and its height is that width over the ratio; its\ncontent is clipped to it (`overflow: \"hidden\"`), so a picture fills the box rather than spilling out\nof it. `aspectRatioLook(ratio)` is exported for a box an app draws itself."},"170":{"id":"/docs/components/attachment","page_id":"/docs/components/attachment","type":"page","content":"Attachment","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/attachment"},"171":{"id":"/docs/components/attachment-0","page_id":"/docs/components/attachment","tags":[],"type":"text","url":"/docs/components/attachment","content":"A file, a picture or a link carried by a message: its media, its name, how it is doing, and what can be done to it."},"172":{"id":"/docs/components/attachment-1","page_id":"/docs/components/attachment","type":"heading","tags":[],"url":"/docs/components/attachment#installation","content":"Installation"},"173":{"id":"/docs/components/attachment-2","page_id":"/docs/components/attachment","type":"heading","tags":[],"url":"/docs/components/attachment#usage","content":"Usage"},"174":{"id":"/docs/components/attachment-3","page_id":"/docs/components/attachment","type":"heading","tags":[],"url":"/docs/components/attachment#composition","content":"Composition"},"175":{"id":"/docs/components/attachment-4","page_id":"/docs/components/attachment","type":"heading","tags":[],"url":"/docs/components/attachment#examples","content":"Examples"},"176":{"id":"/docs/components/attachment-5","page_id":"/docs/components/attachment","type":"heading","tags":[],"url":"/docs/components/attachment#size","content":"Size"},"177":{"id":"/docs/components/attachment-6","page_id":"/docs/components/attachment","type":"heading","tags":[],"url":"/docs/components/attachment#states","content":"States"},"178":{"id":"/docs/components/attachment-7","page_id":"/docs/components/attachment","type":"heading","tags":[],"url":"/docs/components/attachment#pictures","content":"Pictures"},"179":{"id":"/docs/components/attachment-8","page_id":"/docs/components/attachment","type":"heading","tags":[],"url":"/docs/components/attachment#actions","content":"Actions"},"180":{"id":"/docs/components/attachment-9","page_id":"/docs/components/attachment","type":"heading","tags":[],"url":"/docs/components/attachment#a-frame-that-opens","content":"A frame that opens"},"181":{"id":"/docs/components/attachment-10","page_id":"/docs/components/attachment","type":"heading","tags":[],"url":"/docs/components/attachment#group","content":"Group"},"182":{"id":"/docs/components/attachment-11","page_id":"/docs/components/attachment","type":"heading","tags":[],"url":"/docs/components/attachment#api","content":"API"},"183":{"id":"/docs/components/attachment-12","page_id":"/docs/components/attachment","tags":[],"type":"text","url":"/docs/components/attachment#usage","content":"The examples draw icons with `Icon` from `lib/ui/icons`; see Icons for adding it and picking a size and color."},"184":{"id":"/docs/components/attachment-13","page_id":"/docs/components/attachment","tags":[],"type":"text","url":"/docs/components/attachment#composition","content":"Use the following composition to build an `Attachment`:"},"185":{"id":"/docs/components/attachment-14","page_id":"/docs/components/attachment","tags":[],"type":"text","url":"/docs/components/attachment#size","content":"`size` is `default` (40-point media, the body's type), `sm` (32, the note's) or `xs` (28, the\nnote's, in a chip's corners)."},"186":{"id":"/docs/components/attachment-15","page_id":"/docs/components/attachment","tags":[],"type":"text","url":"/docs/components/attachment#states","content":"`state` says how the attachment is doing: `idle` (not sent yet, its edge dashed), `uploading`,\n`processing`, `done`, and `error` (the danger tone through the frame, the media and the\ndescription). Put a `Spinner` in the media while it travels."},"187":{"id":"/docs/components/attachment-16","page_id":"/docs/components/attachment","tags":[],"type":"text","url":"/docs/components/attachment#pictures","content":"`orientation=\"vertical\"` puts the media above the text, 120 points wide, for a strip of pictures.\n`AttachmentMedia` takes a picture drawn inside it: give it `variant=\"image\"` and it fades the media\nuntil the attachment is done or idle."},"188":{"id":"/docs/components/attachment-17","page_id":"/docs/components/attachment","tags":[],"type":"text","url":"/docs/components/attachment#actions","content":"`AttachmentActions` holds what can be done to the file — a remove, a retry — beside the text, or\nin the corner of a vertical attachment. `AttachmentAction` is this library's `Button`, ghost and\nsmall, for a labeled action such as Retry. Remove is an `IconButton` in that row; there is no `onRemove`. Give the icon button a square `style` (`width` and\n`height` 28) so it sits in the chip; the ghost button's own padding reads as a separate pill."},"189":{"id":"/docs/components/attachment-18","page_id":"/docs/components/attachment","tags":[],"type":"text","url":"/docs/components/attachment#a-frame-that-opens","content":"`AttachmentTrigger` is a pressable over the whole frame, above the media and below the actions:\npressing the file opens it, and under the pointer it shows its own wash. Name it for screen readers."},"190":{"id":"/docs/components/attachment-19","page_id":"/docs/components/attachment","tags":[],"type":"text","url":"/docs/components/attachment#group","content":"`AttachmentGroup` is a row of attachments 12 points apart that scrolls sideways when they do not\nfit — the files under a message, the pictures in a composer. The row takes the platform's own feel:\nno snapping, and no scrollbar."},"191":{"id":"/docs/components/attachment-20","page_id":"/docs/components/attachment","tags":[],"type":"text","url":"/docs/components/attachment#api","content":"Every prop of `nsh` View passes through on every part;\n`AttachmentAction` takes this library's `Button` props,\n`AttachmentTrigger` the view's (`onPress`, `accessibilityLabel`, `disabled`, …), and\n`AttachmentTitle`/`AttachmentDescription` the text's. A title or a description is one line,\ntruncated."},"192":{"id":"/docs/components/attachment-21","page_id":"/docs/components/attachment","tags":[],"type":"text","url":"/docs/components/attachment#api","content":"| Part         | Props                          | Description                                                                         |\n| ------------ | ------------------------------ | ----------------------------------------------------------------------------------- |\n| `Attachment` | `state`, `size`, `orientation` | The frame that carries one file: `attachmentLook().root(state, size, orientation)`. |","table":"table-0"},"193":{"id":"/docs/components/attachment-22","page_id":"/docs/components/attachment","tags":[],"type":"text","url":"/docs/components/attachment#api","content":"| Part              | Props | Description                                                                                       |\n| ----------------- | ----- | ------------------------------------------------------------------------------------------------- |\n| `AttachmentGroup` | —     | A row 12 points apart that scrolls sideways when the files do not fit: `.group`, `.groupContent`. |","table":"table-0"},"194":{"id":"/docs/components/attachment-23","page_id":"/docs/components/attachment","tags":[],"type":"text","url":"/docs/components/attachment#api","content":"| Part              | Props     | Description                                                                              |\n| ----------------- | --------- | ---------------------------------------------------------------------------------------- |\n| `AttachmentMedia` | `variant` | The file's icon or picture: `attachmentLook().media(size, orientation, variant, state)`. |","table":"table-0"},"195":{"id":"/docs/components/attachment-24","page_id":"/docs/components/attachment","tags":[],"type":"text","url":"/docs/components/attachment#api","content":"| Part                | Props | Description                                                         |\n| ------------------- | ----- | ------------------------------------------------------------------- |\n| `AttachmentContent` | —     | The text beside the media: `attachmentLook().content(orientation)`. |","table":"table-0"},"196":{"id":"/docs/components/attachment-25","page_id":"/docs/components/attachment","tags":[],"type":"text","url":"/docs/components/attachment#api","content":"| Part              | Props | Description                                                           |\n| ----------------- | ----- | --------------------------------------------------------------------- |\n| `AttachmentTitle` | —     | The file's name, one line, truncated: `attachmentLook().title(size)`. |","table":"table-0"},"197":{"id":"/docs/components/attachment-26","page_id":"/docs/components/attachment","tags":[],"type":"text","url":"/docs/components/attachment#api","content":"| Part                    | Props | Description                                                             |\n| ----------------------- | ----- | ----------------------------------------------------------------------- |\n| `AttachmentDescription` | —     | How the file is doing, one line: `attachmentLook().description(state)`. |","table":"table-0"},"198":{"id":"/docs/components/attachment-27","page_id":"/docs/components/attachment","tags":[],"type":"text","url":"/docs/components/attachment#api","content":"| Part                | Props | Description                                                      |\n| ------------------- | ----- | ---------------------------------------------------------------- |\n| `AttachmentActions` | —     | What can be done to it: `attachmentLook().actions(orientation)`. |","table":"table-0"},"199":{"id":"/docs/components/attachment-28","page_id":"/docs/components/attachment","tags":[],"type":"text","url":"/docs/components/attachment#api","content":"| Part                | Props | Description                                                  |\n| ------------------- | ----- | ------------------------------------------------------------ |\n| `AttachmentTrigger` | —     | A pressable over the whole frame: press it to open the file. |","table":"table-0"},"200":{"id":"/docs/components/attachment-29","page_id":"/docs/components/attachment","tags":[],"type":"text","url":"/docs/components/attachment#api","content":"| Part               | Props | Description                                                                                            |\n| ------------------ | ----- | ------------------------------------------------------------------------------------------------------ |\n| `AttachmentAction` | —     | An action on the file, this library's `Button` ghost and small: `buttonLook(\"ghost\", { size: \"sm\" })`. |","table":"table-0"},"201":{"id":"/docs/components/attachment-30","page_id":"/docs/components/attachment","tags":[],"type":"text","url":"/docs/components/attachment#api","content":"| Prop    | On           | Type                                                         | Default |\n| ------- | ------------ | ------------------------------------------------------------ | ------- |\n| `state` | `Attachment` | `\"idle\" \\| \"uploading\" \\| \"processing\" \\| \"error\" \\| \"done\"` | `done`  |","table":"table-1"},"202":{"id":"/docs/components/attachment-31","page_id":"/docs/components/attachment","tags":[],"type":"text","url":"/docs/components/attachment#api","content":"| Prop   | On           | Type                        | Default   |\n| ------ | ------------ | --------------------------- | --------- |\n| `size` | `Attachment` | `\"default\" \\| \"sm\" \\| \"xs\"` | `default` |","table":"table-1"},"203":{"id":"/docs/components/attachment-32","page_id":"/docs/components/attachment","tags":[],"type":"text","url":"/docs/components/attachment#api","content":"| Prop          | On           | Type                         | Default      |\n| ------------- | ------------ | ---------------------------- | ------------ |\n| `orientation` | `Attachment` | `\"horizontal\" \\| \"vertical\"` | `horizontal` |","table":"table-1"},"204":{"id":"/docs/components/attachment-33","page_id":"/docs/components/attachment","tags":[],"type":"text","url":"/docs/components/attachment#api","content":"| Prop      | On                | Type                | Default |\n| --------- | ----------------- | ------------------- | ------- |\n| `variant` | `AttachmentMedia` | `\"icon\" \\| \"image\"` | `icon`  |","table":"table-1"},"205":{"id":"/docs/components/attachment-34","page_id":"/docs/components/attachment","tags":[],"type":"text","url":"/docs/components/attachment#api","content":"The frame is as wide as what it holds (`default` 160 points wide at least, 120 when vertical), in\nthe card's fill with a hairline edge and the card's corners (`inset`'s at `xs`), 10 / 8 / 6 points\nin from its edge and 8 / 6 / 4 above and below; the title is medium in the page's ink and the\ndescription the note's size in the muted ink. The frame always pads as if it holds text, so a\nmedia on its own sits in that padding. `attachmentLook()` and\n`attachmentGlyph(size, orientation)` are exported for a frame an app draws itself."},"206":{"id":"/docs/components/avatar","page_id":"/docs/components/avatar","type":"page","content":"Avatar","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/avatar"},"207":{"id":"/docs/components/avatar-0","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar","content":"A round picture or name-colored initials on the identity ring."},"208":{"id":"/docs/components/avatar-1","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#installation","content":"Installation"},"209":{"id":"/docs/components/avatar-2","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#usage","content":"Usage"},"210":{"id":"/docs/components/avatar-3","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#composition","content":"Composition"},"211":{"id":"/docs/components/avatar-4","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#examples","content":"Examples"},"212":{"id":"/docs/components/avatar-5","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#initials","content":"Initials"},"213":{"id":"/docs/components/avatar-6","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#picture","content":"Picture"},"214":{"id":"/docs/components/avatar-7","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#broken-image","content":"Broken image"},"215":{"id":"/docs/components/avatar-8","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#group","content":"Group"},"216":{"id":"/docs/components/avatar-9","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#presence","content":"Presence"},"217":{"id":"/docs/components/avatar-10","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#api","content":"API"},"218":{"id":"/docs/components/avatar-11","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#composition","content":"Use the following composition to build an `Avatar`:"},"219":{"id":"/docs/components/avatar-12","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#initials","content":"`name` picks a stable hue via `avatarIdentity`."},"220":{"id":"/docs/components/avatar-13","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#picture","content":"`src` is the picture; `name`'s initials cover it while it loads, and stay if it never arrives."},"221":{"id":"/docs/components/avatar-14","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#broken-image","content":"A picture that fails to load leaves the initials on the ring, as a gone picture should."},"222":{"id":"/docs/components/avatar-15","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#group","content":"`AvatarGroup` shows the first `limit` and overlaps them (`-space-x-2`). `AvatarGroupCount` is the overflow circle's text. Size each `Avatar` the same, and size the overflow with `overflowStyle`."},"223":{"id":"/docs/components/avatar-16","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#presence","content":"`AvatarBadge` sits on the avatar's end-bottom corner. Pass its color; say the presence in `accessibilityLabel`. The avatar does not clip it."},"224":{"id":"/docs/components/avatar-17","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#api","content":"Uses `avatarIdentity` and `avatarHue`. Every prop of `nsh/base` Avatar passes through on `Avatar`, and every prop of `nsh/base` AvatarGroup on `AvatarGroup` (`limit`, `total`, `overflow`, `overflowAccessibilityLabel`)."},"225":{"id":"/docs/components/avatar-18","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#api","content":"| Part     | Props         | Description                                                    |\n| -------- | ------------- | -------------------------------------------------------------- |\n| `Avatar` | `name`, `src` | A round picture or name-colored initials on the identity ring. |","table":"table-0"},"226":{"id":"/docs/components/avatar-19","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#api","content":"| Part          | Props                        | Description                                                 |\n| ------------- | ---------------------------- | ----------------------------------------------------------- |\n| `AvatarGroup` | `limit`, `total`, `overflow` | The first few avatars, overlapped; the rest are `overflow`. |","table":"table-0"},"227":{"id":"/docs/components/avatar-20","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#api","content":"| Part               | Props | Description                              |\n| ------------------ | ----- | ---------------------------------------- |\n| `AvatarGroupCount` | —     | The overflow's count, tabular and muted. |","table":"table-0"},"228":{"id":"/docs/components/avatar-21","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#api","content":"| Part          | Props | Description                                                                |\n| ------------- | ----- | -------------------------------------------------------------------------- |\n| `AvatarBadge` | —     | A presence circle at the end-bottom corner, ringed in the page background. |","table":"table-0"},"229":{"id":"/docs/components/badge","page_id":"/docs/components/badge","type":"page","content":"Badge","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/badge"},"230":{"id":"/docs/components/badge-0","page_id":"/docs/components/badge","tags":[],"type":"text","url":"/docs/components/badge","content":"A small capsule label in a neutral, toned, or outline style."},"231":{"id":"/docs/components/badge-1","page_id":"/docs/components/badge","type":"heading","tags":[],"url":"/docs/components/badge#installation","content":"Installation"},"232":{"id":"/docs/components/badge-2","page_id":"/docs/components/badge","type":"heading","tags":[],"url":"/docs/components/badge#usage","content":"Usage"},"233":{"id":"/docs/components/badge-3","page_id":"/docs/components/badge","type":"heading","tags":[],"url":"/docs/components/badge#examples","content":"Examples"},"234":{"id":"/docs/components/badge-4","page_id":"/docs/components/badge","type":"heading","tags":[],"url":"/docs/components/badge#tone","content":"Tone"},"235":{"id":"/docs/components/badge-5","page_id":"/docs/components/badge","type":"heading","tags":[],"url":"/docs/components/badge#variant","content":"Variant"},"236":{"id":"/docs/components/badge-6","page_id":"/docs/components/badge","type":"heading","tags":[],"url":"/docs/components/badge#size","content":"Size"},"237":{"id":"/docs/components/badge-7","page_id":"/docs/components/badge","type":"heading","tags":[],"url":"/docs/components/badge#api","content":"API"},"238":{"id":"/docs/components/badge-8","page_id":"/docs/components/badge","tags":[],"type":"text","url":"/docs/components/badge#tone","content":"`tone` is the theme's `Tone`; a function is read where the badge is drawn, so a value the app changes follows."},"239":{"id":"/docs/components/badge-9","page_id":"/docs/components/badge","tags":[],"type":"text","url":"/docs/components/badge#variant","content":"`default` fills the capsule with the tone's tint; `outline` draws its edge in the tone's color instead."},"240":{"id":"/docs/components/badge-10","page_id":"/docs/components/badge","tags":[],"type":"text","url":"/docs/components/badge#size","content":"`default` is 20 points tall; `sm` is 18, for a chip beside a smaller row — a tool card's 32 pt tile, a list's second line. The label's size and the padding follow the height."},"241":{"id":"/docs/components/badge-11","page_id":"/docs/components/badge","tags":[],"type":"text","url":"/docs/components/badge#api","content":"Gallery atom: no `nsh/base` counterpart. The children are the label, and the axes take the vocabulary of `api-unify.md`."},"242":{"id":"/docs/components/badge-12","page_id":"/docs/components/badge","tags":[],"type":"text","url":"/docs/components/badge#api","content":"| Part    | Props                                                                                                                                                                                                    | Description                                                  |\n| ------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | ------------------------------------------------------------ |\n| `Badge` | `children` (a string, required); `tone`: `Tone \\| (() => Tone)` (default `\"neutral\"`); `variant`: `BadgeVariant` (default `\"default\"`); `size`: `BadgeSize` (default `\"default\"`); every `nsh` view prop | A small capsule label in a neutral, toned, or outline style. |","table":"table-0"},"243":{"id":"/docs/components/badge-13","page_id":"/docs/components/badge","tags":[],"type":"text","url":"/docs/components/badge#api","content":"The view props (`style`, `class`, `testID`, `role`, the accessibility ones) are spread on the capsule after the badge's own, so an app can name it to a screen reader or take it out of the layout without a wrapper."},"244":{"id":"/docs/components/badge-14","page_id":"/docs/components/badge","tags":[],"type":"text","url":"/docs/components/badge#api","content":"`BadgeVariant` is `\"default\" | \"outline\"`: the two the capsule's look has. `BadgeSize` is `\"sm\" | \"default\"`, and `badgeSizes` is the table: `height`, `font` and `pad`, by size."},"245":{"id":"/docs/components/breadcrumb","page_id":"/docs/components/breadcrumb","type":"page","content":"Breadcrumb","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/breadcrumb"},"246":{"id":"/docs/components/breadcrumb-0","page_id":"/docs/components/breadcrumb","tags":[],"type":"text","url":"/docs/components/breadcrumb","content":"The trail from where the app starts to the page it shows."},"247":{"id":"/docs/components/breadcrumb-1","page_id":"/docs/components/breadcrumb","type":"heading","tags":[],"url":"/docs/components/breadcrumb#installation","content":"Installation"},"248":{"id":"/docs/components/breadcrumb-2","page_id":"/docs/components/breadcrumb","type":"heading","tags":[],"url":"/docs/components/breadcrumb#usage","content":"Usage"},"249":{"id":"/docs/components/breadcrumb-3","page_id":"/docs/components/breadcrumb","type":"heading","tags":[],"url":"/docs/components/breadcrumb#composition","content":"Composition"},"250":{"id":"/docs/components/breadcrumb-4","page_id":"/docs/components/breadcrumb","type":"heading","tags":[],"url":"/docs/components/breadcrumb#examples","content":"Examples"},"251":{"id":"/docs/components/breadcrumb-5","page_id":"/docs/components/breadcrumb","type":"heading","tags":[],"url":"/docs/components/breadcrumb#a-trail","content":"A trail"},"252":{"id":"/docs/components/breadcrumb-6","page_id":"/docs/components/breadcrumb","type":"heading","tags":[],"url":"/docs/components/breadcrumb#steps-left-out","content":"Steps left out"},"253":{"id":"/docs/components/breadcrumb-7","page_id":"/docs/components/breadcrumb","type":"heading","tags":[],"url":"/docs/components/breadcrumb#a-separator-of-your-own","content":"A separator of your own"},"254":{"id":"/docs/components/breadcrumb-8","page_id":"/docs/components/breadcrumb","type":"heading","tags":[],"url":"/docs/components/breadcrumb#a-step-with-a-destination","content":"A step with a destination"},"255":{"id":"/docs/components/breadcrumb-9","page_id":"/docs/components/breadcrumb","type":"heading","tags":[],"url":"/docs/components/breadcrumb#api","content":"API"},"256":{"id":"/docs/components/breadcrumb-10","page_id":"/docs/components/breadcrumb","tags":[],"type":"text","url":"/docs/components/breadcrumb#composition","content":"Use the following composition to build a `Breadcrumb`:"},"257":{"id":"/docs/components/breadcrumb-11","page_id":"/docs/components/breadcrumb","tags":[],"type":"text","url":"/docs/components/breadcrumb#a-trail","content":"The steps are a row that wraps when the window is narrow; the page the trail ends at is\n`BreadcrumbPage`, in the page's text color, and is announced as the current page."},"258":{"id":"/docs/components/breadcrumb-12","page_id":"/docs/components/breadcrumb","tags":[],"type":"text","url":"/docs/components/breadcrumb#steps-left-out","content":"`BreadcrumbEllipsis` stands for the steps a long trail leaves out. It is named `\"More\"`, so a\nscreen reader says the trail skipped some rather than jumping from one name to the next; give it\n`onPress` and `role=\"button\"` when it opens a menu."},"259":{"id":"/docs/components/breadcrumb-13","page_id":"/docs/components/breadcrumb","tags":[],"type":"text","url":"/docs/components/breadcrumb#a-separator-of-your-own","content":"A separator is a chevron; its children replace it (a slash, a dot, a small icon)."},"260":{"id":"/docs/components/breadcrumb-14","page_id":"/docs/components/breadcrumb","tags":[],"type":"text","url":"/docs/components/breadcrumb#a-step-with-a-destination","content":"A step is `nsh/base`'s Link, so `href` and `openWith` work as they\ndo everywhere else: `\"system\"` opens the URL outside the app, `\"app\"` hands it to `onOpen`."},"261":{"id":"/docs/components/breadcrumb-15","page_id":"/docs/components/breadcrumb","tags":[],"type":"text","url":"/docs/components/breadcrumb#api","content":"Every prop of `nsh` View passes through on `Breadcrumb`,\n`BreadcrumbList`, `BreadcrumbItem`, `BreadcrumbSeparator` and `BreadcrumbEllipsis`, and every prop\nof `nsh` Text on `BreadcrumbPage`; `BreadcrumbLink` is\n`nsh/base`'s Link with all its props (`href`, `openWith`, `onOpen`,\n`onPress`, `disabled`, `hitSlop`, …). Style props go over the look's."},"262":{"id":"/docs/components/breadcrumb-16","page_id":"/docs/components/breadcrumb","tags":[],"type":"text","url":"/docs/components/breadcrumb#api","content":"The trail is a `navigation` landmark named `\"Breadcrumb\"`; the rows under it carry no role. `nsh`\nhas no `listitem` role, so `BreadcrumbList` is not a `list` either: a list whose children are not\nits items reads worse than a plain row, and `ItemGroup` makes the same call."},"263":{"id":"/docs/components/breadcrumb-17","page_id":"/docs/components/breadcrumb","tags":[],"type":"text","url":"/docs/components/breadcrumb#api","content":"| Part         | Props                | Description                                                                        |\n| ------------ | -------------------- | ---------------------------------------------------------------------------------- |\n| `Breadcrumb` | `accessibilityLabel` | The trail from where the app starts to the page it shows: `breadcrumbLook().root`. |","table":"table-0"},"264":{"id":"/docs/components/breadcrumb-18","page_id":"/docs/components/breadcrumb","tags":[],"type":"text","url":"/docs/components/breadcrumb#api","content":"| Part             | Props                 | Description                                                                       |\n| ---------------- | --------------------- | --------------------------------------------------------------------------------- |\n| `BreadcrumbList` | every `nsh` view prop | The steps as a row that wraps when the window is narrow: `breadcrumbLook().list`. |","table":"table-0"},"265":{"id":"/docs/components/breadcrumb-19","page_id":"/docs/components/breadcrumb","tags":[],"type":"text","url":"/docs/components/breadcrumb#api","content":"| Part             | Props | Description                        |\n| ---------------- | ----- | ---------------------------------- |\n| `BreadcrumbItem` | —     | One step: `breadcrumbLook().item`. |","table":"table-0"},"266":{"id":"/docs/components/breadcrumb-20","page_id":"/docs/components/breadcrumb","tags":[],"type":"text","url":"/docs/components/breadcrumb#api","content":"| Part             | Props                                  | Description                                                       |\n| ---------------- | -------------------------------------- | ----------------------------------------------------------------- |\n| `BreadcrumbLink` | `children`, every `nsh/base` Link prop | A step with a destination: `breadcrumbLook().link`, `.linkClass`. |","table":"table-0"},"267":{"id":"/docs/components/breadcrumb-21","page_id":"/docs/components/breadcrumb","tags":[],"type":"text","url":"/docs/components/breadcrumb#api","content":"| Part             | Props | Description                                                                                                   |\n| ---------------- | ----- | ------------------------------------------------------------------------------------------------------------- |\n| `BreadcrumbPage` | —     | The step the trail ends at, in the page's text color and current for screen readers: `breadcrumbLook().page`. |","table":"table-0"},"268":{"id":"/docs/components/breadcrumb-22","page_id":"/docs/components/breadcrumb","tags":[],"type":"text","url":"/docs/components/breadcrumb#api","content":"| Part                  | Props      | Description                                                                            |\n| --------------------- | ---------- | -------------------------------------------------------------------------------------- |\n| `BreadcrumbSeparator` | `children` | The mark between steps, a chevron unless given children: `breadcrumbLook().separator`. |","table":"table-0"},"269":{"id":"/docs/components/breadcrumb-23","page_id":"/docs/components/breadcrumb","tags":[],"type":"text","url":"/docs/components/breadcrumb#api","content":"| Part                 | Props                | Description                                                                     |\n| -------------------- | -------------------- | ------------------------------------------------------------------------------- |\n| `BreadcrumbEllipsis` | `accessibilityLabel` | The steps a long trail leaves out, named `\"More\"`: `breadcrumbLook().ellipsis`. |","table":"table-0"},"270":{"id":"/docs/components/breadcrumb-24","page_id":"/docs/components/breadcrumb","tags":[],"type":"text","url":"/docs/components/breadcrumb#api","content":"| Prop                 | On           | Type     | Default        |\n| -------------------- | ------------ | -------- | -------------- |\n| `accessibilityLabel` | `Breadcrumb` | `string` | `\"Breadcrumb\"` |","table":"table-1"},"271":{"id":"/docs/components/breadcrumb-25","page_id":"/docs/components/breadcrumb","tags":[],"type":"text","url":"/docs/components/breadcrumb#api","content":"| Prop       | On               | Type                    | Default |\n| ---------- | ---------------- | ----------------------- | ------- |\n| `children` | `BreadcrumbLink` | `string \\| JSX.Element` |         |","table":"table-1"},"272":{"id":"/docs/components/breadcrumb-26","page_id":"/docs/components/breadcrumb","tags":[],"type":"text","url":"/docs/components/breadcrumb#api","content":"| Prop       | On                    | Type          | Default   |\n| ---------- | --------------------- | ------------- | --------- |\n| `children` | `BreadcrumbSeparator` | `JSX.Element` | a chevron |","table":"table-1"},"273":{"id":"/docs/components/breadcrumb-27","page_id":"/docs/components/breadcrumb","tags":[],"type":"text","url":"/docs/components/breadcrumb#api","content":"| Prop                 | On                   | Type     | Default  |\n| -------------------- | -------------------- | -------- | -------- |\n| `accessibilityLabel` | `BreadcrumbEllipsis` | `string` | `\"More\"` |","table":"table-1"},"274":{"id":"/docs/components/breadcrumb-28","page_id":"/docs/components/breadcrumb","tags":[],"type":"text","url":"/docs/components/breadcrumb#api","content":"The trail is small type in the muted ink, 6 points between steps (10 on a touch screen); a step's\nlink takes the text color while the pointer rests on it and the theme's focus ring with the keyboard\non it. `BreadcrumbPage` sets `accessibilityState.current` to `\"page\"`; pass your own\n`accessibilityState` to say something else. The separator is hidden from screen readers. In a\nterminal, which draws no icons, the separator is `›` and the ellipsis `…`. `breadcrumbLook()` is\nexported for a trail an app draws itself."},"275":{"id":"/docs/components/bubble","page_id":"/docs/components/bubble","type":"page","content":"Bubble","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/bubble"},"276":{"id":"/docs/components/bubble-0","page_id":"/docs/components/bubble","tags":[],"type":"text","url":"/docs/components/bubble","content":"The framed surface of one turn of a conversation, and the reactions that hang off it."},"277":{"id":"/docs/components/bubble-1","page_id":"/docs/components/bubble","type":"heading","tags":[],"url":"/docs/components/bubble#installation","content":"Installation"},"278":{"id":"/docs/components/bubble-2","page_id":"/docs/components/bubble","type":"heading","tags":[],"url":"/docs/components/bubble#usage","content":"Usage"},"279":{"id":"/docs/components/bubble-3","page_id":"/docs/components/bubble","type":"heading","tags":[],"url":"/docs/components/bubble#composition","content":"Composition"},"280":{"id":"/docs/components/bubble-4","page_id":"/docs/components/bubble","type":"heading","tags":[],"url":"/docs/components/bubble#examples","content":"Examples"},"281":{"id":"/docs/components/bubble-5","page_id":"/docs/components/bubble","type":"heading","tags":[],"url":"/docs/components/bubble#fills","content":"Fills"},"282":{"id":"/docs/components/bubble-6","page_id":"/docs/components/bubble","type":"heading","tags":[],"url":"/docs/components/bubble#alignment","content":"Alignment"},"283":{"id":"/docs/components/bubble-7","page_id":"/docs/components/bubble","type":"heading","tags":[],"url":"/docs/components/bubble#group","content":"Group"},"284":{"id":"/docs/components/bubble-8","page_id":"/docs/components/bubble","type":"heading","tags":[],"url":"/docs/components/bubble#rich-content","content":"Rich content"},"285":{"id":"/docs/components/bubble-9","page_id":"/docs/components/bubble","type":"heading","tags":[],"url":"/docs/components/bubble#reactions","content":"Reactions"},"286":{"id":"/docs/components/bubble-10","page_id":"/docs/components/bubble","type":"heading","tags":[],"url":"/docs/components/bubble#a-tail","content":"A tail"},"287":{"id":"/docs/components/bubble-11","page_id":"/docs/components/bubble","type":"heading","tags":[],"url":"/docs/components/bubble#a-turn-that-acts","content":"A turn that acts"},"288":{"id":"/docs/components/bubble-12","page_id":"/docs/components/bubble","type":"heading","tags":[],"url":"/docs/components/bubble#api","content":"API"},"289":{"id":"/docs/components/bubble-13","page_id":"/docs/components/bubble","tags":[],"type":"text","url":"/docs/components/bubble#composition","content":"Use the following composition to build a `Bubble`:"},"290":{"id":"/docs/components/bubble-14","page_id":"/docs/components/bubble","tags":[],"type":"text","url":"/docs/components/bubble#fills","content":"`variant` changes the frame. `default` is the accent's fill and ink — what you send; `secondary`\nthe raised neutral; `muted` a quieter fill; `tinted` the accent as a soft wash; `outline` a\nhairline around the page's fill; `ghost` no frame at all, for assistant text that takes the whole\nwidth; `destructive` for a turn that failed. Every fill keeps a 1-point edge, transparent where it\nhas no color, so the box is the same size."},"291":{"id":"/docs/components/bubble-15","page_id":"/docs/components/bubble","tags":[],"type":"text","url":"/docs/components/bubble#alignment","content":"`align=\"end\"` puts the bubble on the side of what you sent; `align=\"start\"` (the default) on the\nside of what came in. A bubble is as wide as what it holds, up to 80% of its column; a `ghost` one\nuses the whole width."},"292":{"id":"/docs/components/bubble-16","page_id":"/docs/components/bubble","tags":[],"type":"text","url":"/docs/components/bubble#group","content":"`BubbleGroup` stacks consecutive bubbles from one sender 8 points apart. Each `Bubble` keeps its\nown `align`."},"293":{"id":"/docs/components/bubble-17","page_id":"/docs/components/bubble","tags":[],"type":"text","url":"/docs/components/bubble#rich-content","content":"`BubbleText` is a `Text` in the bubble's type and the ink of the variant around it. NSH has no text\ninheritance — the web gives a bubble's ink to whatever its content holds, NSH does not — so content\nthat is not a single string (a list of paragraphs, markdown rendered into text) wears `BubbleText`\nrather than knowing the variant itself. `BubbleContent` draws a string child the same way."},"294":{"id":"/docs/components/bubble-18","page_id":"/docs/components/bubble","tags":[],"type":"text","url":"/docs/components/bubble#reactions","content":"`BubbleReactions` is a pill in the muted fill that hangs three quarters of its height off the\nbubble's `side` edge (`bottom` by default, or `top`), 12 points in from its `align` end. The\nbubble keeps the room the row hangs out on that side, so the next bubble never covers it. Name the\nrow for screen readers: NSH reads each glyph without context otherwise."},"295":{"id":"/docs/components/bubble-19","page_id":"/docs/components/bubble","tags":[],"type":"text","url":"/docs/components/bubble#a-tail","content":"The sender's bottom corner is squarer than the rest. It is a recipe, not a prop — a `style` on\n`BubbleContent` that reads the theme's `shape`. Use the logical corner (`borderBottomEndRadius` for\nwhat you send, `borderBottomStartRadius` for what came in) so it follows the reading direction."},"296":{"id":"/docs/components/bubble-20","page_id":"/docs/components/bubble","tags":[],"type":"text","url":"/docs/components/bubble#a-turn-that-acts","content":"Give `BubbleContent` `onPress` for a quick reply or a suggestion: the pointer over it is a hand.\nThe frame itself takes the press."},"297":{"id":"/docs/components/bubble-21","page_id":"/docs/components/bubble","tags":[],"type":"text","url":"/docs/components/bubble#api","content":"Every prop of `nsh` View passes through on `BubbleGroup`,\n`Bubble` and `BubbleContent`; `BubbleText` takes every prop of\n`nsh` Text, and `BubbleContent` draws a string child as a\n`BubbleText`. Style props go over the look's."},"298":{"id":"/docs/components/bubble-22","page_id":"/docs/components/bubble","tags":[],"type":"text","url":"/docs/components/bubble#api","content":"| Part          | Props | Description                                                                |\n| ------------- | ----- | -------------------------------------------------------------------------- |\n| `BubbleGroup` | —     | Consecutive bubbles from one sender, 8 points apart: `bubbleLook().group`. |","table":"table-0"},"299":{"id":"/docs/components/bubble-23","page_id":"/docs/components/bubble","tags":[],"type":"text","url":"/docs/components/bubble#api","content":"| Part     | Props              | Description                                                                                  |\n| -------- | ------------------ | -------------------------------------------------------------------------------------------- |\n| `Bubble` | `variant`, `align` | One turn's frame, as wide as what it holds up to 80% of its column: `.root(variant, align)`. |","table":"table-0"},"300":{"id":"/docs/components/bubble-24","page_id":"/docs/components/bubble","tags":[],"type":"text","url":"/docs/components/bubble#api","content":"| Part            | Props      | Description                                                                              |\n| --------------- | ---------- | ---------------------------------------------------------------------------------------- |\n| `BubbleContent` | `children` | The frame and the turn, a string drawn as `BubbleText`: `bubbleLook().content(variant)`. |","table":"table-0"},"301":{"id":"/docs/components/bubble-25","page_id":"/docs/components/bubble","tags":[],"type":"text","url":"/docs/components/bubble#api","content":"| Part         | Props | Description                                                                         |\n| ------------ | ----- | ----------------------------------------------------------------------------------- |\n| `BubbleText` | —     | A paragraph in the turn's type and the variant's ink: `bubbleLook().text(variant)`. |","table":"table-0"},"302":{"id":"/docs/components/bubble-26","page_id":"/docs/components/bubble","tags":[],"type":"text","url":"/docs/components/bubble#api","content":"| Part              | Props           | Description                                                                                                                           |\n| ----------------- | --------------- | ------------------------------------------------------------------------------------------------------------------------------------- |\n| `BubbleReactions` | `side`, `align` | The pill hung three quarters of its height off the bubble's edge: `.reactions(side, align)`; the bubble keeps `.reactionsRoom(side)`. |","table":"table-0"},"303":{"id":"/docs/components/bubble-27","page_id":"/docs/components/bubble","tags":[],"type":"text","url":"/docs/components/bubble#api","content":"| Prop      | On       | Type                                                                                       | Default   |\n| --------- | -------- | ------------------------------------------------------------------------------------------ | --------- |\n| `variant` | `Bubble` | `\"default\" \\| \"secondary\" \\| \"muted\" \\| \"tinted\" \\| \"outline\" \\| \"ghost\" \\| \"destructive\"` | `default` |","table":"table-1"},"304":{"id":"/docs/components/bubble-28","page_id":"/docs/components/bubble","tags":[],"type":"text","url":"/docs/components/bubble#api","content":"| Prop    | On       | Type               | Default |\n| ------- | -------- | ------------------ | ------- |\n| `align` | `Bubble` | `\"start\" \\| \"end\"` | `start` |","table":"table-1"},"305":{"id":"/docs/components/bubble-29","page_id":"/docs/components/bubble","tags":[],"type":"text","url":"/docs/components/bubble#api","content":"| Prop   | On                | Type                | Default  |\n| ------ | ----------------- | ------------------- | -------- |\n| `side` | `BubbleReactions` | `\"top\" \\| \"bottom\"` | `bottom` |","table":"table-1"},"306":{"id":"/docs/components/bubble-30","page_id":"/docs/components/bubble","tags":[],"type":"text","url":"/docs/components/bubble#api","content":"| Prop    | On                | Type               | Default |\n| ------- | ----------------- | ------------------ | ------- |\n| `align` | `BubbleReactions` | `\"start\" \\| \"end\"` | `end`   |","table":"table-1"},"307":{"id":"/docs/components/bubble-31","page_id":"/docs/components/bubble","tags":[],"type":"text","url":"/docs/components/bubble#api","content":"| Prop       | On              | Type                    | Default |\n| ---------- | --------------- | ----------------------- | ------- |\n| `children` | `BubbleContent` | `string \\| JSX.Element` |         |","table":"table-1"},"308":{"id":"/docs/components/bubble-32","page_id":"/docs/components/bubble","tags":[],"type":"text","url":"/docs/components/bubble#api","content":"| Prop       | On           | Type          | Default |\n| ---------- | ------------ | ------------- | ------- |\n| `children` | `BubbleText` | `JSX.Element` |         |","table":"table-1"},"309":{"id":"/docs/components/bubble-33","page_id":"/docs/components/bubble","tags":[],"type":"text","url":"/docs/components/bubble#api","content":"The frame is `shape.container` (12 points) with 12 points of room either side and 8 above and below;\nthe turn's type is the body's size (13 points with a pointer, 15 on a touch screen) with a step of\nleading, in the ink the fill carries — `primary-foreground` on `default`, the page's text color on\nthe neutral fills, `destructive` on `destructive`. Reactions are 6 points either side, 3 above and\nbelow, 4 apart, ringed 3 points in the card's color. `bubbleLook()` is exported for a frame an app\ndraws itself."},"310":{"id":"/docs/components/button-group","page_id":"/docs/components/button-group","type":"page","content":"Button group","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/button-group"},"311":{"id":"/docs/components/button-group-0","page_id":"/docs/components/button-group","tags":[],"type":"text","url":"/docs/components/button-group","content":"Buttons joined into one control, in a row or a column."},"312":{"id":"/docs/components/button-group-1","page_id":"/docs/components/button-group","type":"heading","tags":[],"url":"/docs/components/button-group#installation","content":"Installation"},"313":{"id":"/docs/components/button-group-2","page_id":"/docs/components/button-group","type":"heading","tags":[],"url":"/docs/components/button-group#usage","content":"Usage"},"314":{"id":"/docs/components/button-group-3","page_id":"/docs/components/button-group","type":"heading","tags":[],"url":"/docs/components/button-group#composition","content":"Composition"},"315":{"id":"/docs/components/button-group-4","page_id":"/docs/components/button-group","type":"heading","tags":[],"url":"/docs/components/button-group#examples","content":"Examples"},"316":{"id":"/docs/components/button-group-5","page_id":"/docs/components/button-group","type":"heading","tags":[],"url":"/docs/components/button-group#the-join","content":"The join"},"317":{"id":"/docs/components/button-group-6","page_id":"/docs/components/button-group","type":"heading","tags":[],"url":"/docs/components/button-group#a-column","content":"A column"},"318":{"id":"/docs/components/button-group-7","page_id":"/docs/components/button-group","type":"heading","tags":[],"url":"/docs/components/button-group#a-word-and-a-divider","content":"A word and a divider"},"319":{"id":"/docs/components/button-group-8","page_id":"/docs/components/button-group","type":"heading","tags":[],"url":"/docs/components/button-group#api","content":"API"},"320":{"id":"/docs/components/button-group-9","page_id":"/docs/components/button-group","tags":[],"type":"text","url":"/docs/components/button-group#composition","content":"Use the following composition to build a `ButtonGroup`:"},"321":{"id":"/docs/components/button-group-10","page_id":"/docs/components/button-group","tags":[],"type":"text","url":"/docs/components/button-group#the-join","content":"A view styles itself and not its children, so each button wears its own place in the group:\n`item(orientation, position)` squares the sides that touch and keeps one edge per join (the one\nbefore it), the outer sides keeping the corners and the edge the button came with. `first` at the leading edge, `last` at the\ntrailing one, `middle` between two others."},"322":{"id":"/docs/components/button-group-11","page_id":"/docs/components/button-group","tags":[],"type":"text","url":"/docs/components/button-group#the-join","content":"The group is `role=\"group\"`, so a reader hears the buttons as one set."},"323":{"id":"/docs/components/button-group-12","page_id":"/docs/components/button-group","tags":[],"type":"text","url":"/docs/components/button-group#a-column","content":"`orientation=\"vertical\"` stacks them: the corners at the top and the bottom of the column keep the\ncorners, the sides between them are squared, and one hairline is left between two buttons. A button\nbelow another also drops the raised face's lit top edge, which would read as a white seam."},"324":{"id":"/docs/components/button-group-13","page_id":"/docs/components/button-group","tags":[],"type":"text","url":"/docs/components/button-group#a-word-and-a-divider","content":"`ButtonGroupText` is a word inside the group on the muted fill — a path, a unit, a count — and\n`ButtonGroupSeparator` is the hairline between it and what follows. The separator turns with the\ngroup: down a row, across a column. Join the word as a button would be joined; the separator needs\nno join, and is hidden from a reader (it is the group's own hairline)."},"325":{"id":"/docs/components/button-group-14","page_id":"/docs/components/button-group","tags":[],"type":"text","url":"/docs/components/button-group#api","content":"Every prop of `nsh` View passes through on all three parts;\n`style` goes over the look's on each."},"326":{"id":"/docs/components/button-group-15","page_id":"/docs/components/button-group","tags":[],"type":"text","url":"/docs/components/button-group#api","content":"| Part          | Props                                                                | Description                                                                                   |\n| ------------- | -------------------------------------------------------------------- | --------------------------------------------------------------------------------------------- |\n| `ButtonGroup` | `orientation`: `\"horizontal\" \\| \"vertical\"` (default `\"horizontal\"`) | Buttons joined into one control, in a row or a column: `buttonGroupLook().root(orientation)`. |","table":"table-0"},"327":{"id":"/docs/components/button-group-16","page_id":"/docs/components/button-group","tags":[],"type":"text","url":"/docs/components/button-group#api","content":"| Part              | Props | Description                                                                                                  |\n| ----------------- | ----- | ------------------------------------------------------------------------------------------------------------ |\n| `ButtonGroupText` | —     | A word inside the group on the muted fill, joined as a button would be joined: `.textFrame()` and `.text()`. |","table":"table-0"},"328":{"id":"/docs/components/button-group-17","page_id":"/docs/components/button-group","tags":[],"type":"text","url":"/docs/components/button-group#api","content":"| Part                   | Props | Description                                                                   |\n| ---------------------- | ----- | ----------------------------------------------------------------------------- |\n| `ButtonGroupSeparator` | —     | The separator's own, turned to the group's orientation; hidden from a reader. |","table":"table-0"},"329":{"id":"/docs/components/button-group-18","page_id":"/docs/components/button-group","tags":[],"type":"text","url":"/docs/components/button-group#api","content":"| Prop          | Type                         | Default      |\n| ------------- | ---------------------------- | ------------ |\n| `orientation` | `\"horizontal\" \\| \"vertical\"` | `horizontal` |","table":"table-1"},"330":{"id":"/docs/components/button-group-19","page_id":"/docs/components/button-group","tags":[],"type":"text","url":"/docs/components/button-group#api","content":"`buttonGroupLook()` is exported for a group the app lays out itself: `root(orientation)` the group,\n`item(orientation, position)` the join each button wears, `textFrame()` and `text()` the word's box\nand its type."},"331":{"id":"/docs/components/button","page_id":"/docs/components/button","type":"page","content":"Button","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/button"},"332":{"id":"/docs/components/button-0","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button","content":"A button, an icon button, a round button, and a split button."},"333":{"id":"/docs/components/button-1","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#installation","content":"Installation"},"334":{"id":"/docs/components/button-2","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#usage","content":"Usage"},"335":{"id":"/docs/components/button-3","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#examples","content":"Examples"},"336":{"id":"/docs/components/button-4","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#variant","content":"Variant"},"337":{"id":"/docs/components/button-5","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#size","content":"Size"},"338":{"id":"/docs/components/button-6","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#disabled","content":"Disabled"},"339":{"id":"/docs/components/button-7","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#selected","content":"Selected"},"340":{"id":"/docs/components/button-8","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#with-an-icon","content":"With an icon"},"341":{"id":"/docs/components/button-9","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#busy","content":"Busy"},"342":{"id":"/docs/components/button-10","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#any-content","content":"Any content"},"343":{"id":"/docs/components/button-11","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#names-for-screen-readers","content":"Names for screen readers"},"344":{"id":"/docs/components/button-12","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#icon-button","content":"Icon button"},"345":{"id":"/docs/components/button-13","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#round-button","content":"Round button"},"346":{"id":"/docs/components/button-14","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#split-button","content":"Split button"},"347":{"id":"/docs/components/button-15","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#the-look-alone","content":"The look alone"},"348":{"id":"/docs/components/button-16","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#api","content":"API"},"349":{"id":"/docs/components/button-17","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#button","content":"Button"},"350":{"id":"/docs/components/button-18","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#iconbutton","content":"IconButton"},"351":{"id":"/docs/components/button-19","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#roundbutton","content":"RoundButton"},"352":{"id":"/docs/components/button-20","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#splitbutton","content":"SplitButton"},"353":{"id":"/docs/components/button-21","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#usage","content":"The examples draw icons with `Icon` from `lib/ui/icons`; see Icons for adding it and picking a size and color."},"354":{"id":"/docs/components/button-22","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#size","content":"A size is compact with a pointer (24 / 28 / 34 points) and roomier on a touch screen (36 / 40 / 48), where a hit slop makes the target 44 points. `sm`, `default` and `lg` are the only values: a pixel size is a geometry prop (`width`, `side`), not a scale."},"355":{"id":"/docs/components/button-23","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#with-an-icon","content":"`icon` takes a lucide node and draws it before the label, sized and tinted by the variant, the size and the state (a disabled filled button's icon goes muted with its label). The terminal draws no icons, so there it is the label alone."},"356":{"id":"/docs/components/button-24","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#busy","content":"A spinner in the icon's place (before the label when there is no icon), and no second press. A new icon, or the spinner, grows in on `motion.control`; with reduced motion it switches at once. The width follows the label at once: a layout animation would move every frame of the update, app-wide."},"357":{"id":"/docs/components/button-25","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#any-content","content":"A string is the label, and a child that changes (`{count()}` beside other children) is followed the same way. Anything else is drawn as given; `buttonLabel` and `buttonGlyph` give it the button's type and icon size."},"358":{"id":"/docs/components/button-26","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#names-for-screen-readers","content":"A string child is also the button's name for screen readers — they read the text it draws — so `<Button onPress={retry}>Retry</Button>` needs nothing else: a test finds it as `role:button[Retry]`. `accessibilityLabel` still wins when the name should differ from the visible text. Children drawn as given are named by the texts inside them; a button that draws no text needs the `accessibilityLabel` yourself, and an `IconButton` or `RoundButton` (an icon and no text) will not compile without one."},"359":{"id":"/docs/components/button-27","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#icon-button","content":"A square icon-only button; `size` takes four: `xs` 20 points across with a pointer (32 on a touch\nscreen), `sm` 24 (36), `default` 28 (40) and `lg` 32 (44), where a hit slop makes the target 44\npoints and the icon grows with the square. `lg` is upstream's 32 pt tool square, for a rich text\ntoolbar; `xs` is a tab's close × beside a document's name. `selected` (a base prop) shows it as\nchosen."},"360":{"id":"/docs/components/button-28","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#icon-button","content":"`icon` draws a lucide node in the look's size and tint: the accent while selected, the danger tone as\n`destructive`; in the terminal, which draws no icons, the `accessibilityLabel` is its text. For an\nicon of your own, pass it as `children` and spread `iconButtonGlyph` on it. `iconButtonSizes` is the\ntable, for geometry that has to match a square. A ghost icon button keeps the scale's metrics (28\npoints with 12 of padding at `default`, 32 and 16 at `lg`), so a bare square is `IconButton` with\n`size=\"xs\"`; a bare text button — a Dock header's Hide — is `size=\"sm\"`; there is no separate bare\nvariant."},"361":{"id":"/docs/components/button-29","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#icon-button","content":"A tool in a rich text toolbar, at upstream's 32 pt:"},"362":{"id":"/docs/components/button-30","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#round-button","content":"`size` is the scale (28 points at `default` with a pointer, 40 on a touch screen); `side` is an exact diameter where the scale is off."},"363":{"id":"/docs/components/button-31","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#split-button","content":"A main action and a menu half in one silhouette."},"364":{"id":"/docs/components/button-32","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#the-look-alone","content":"The look is a function, for a pressable of your own."},"365":{"id":"/docs/components/button-33","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#the-look-alone","content":"A ghost button's label that should line up with a card's edge is the same `View` with the look's\npadding on its leading side: the look carries `buttonSizes[size].pad` (12 at `default`, 16 at\n`lg`), so a `View` with `paddingLeft: buttonSizes.default.pad` around a ghost `Button` moves the\nlabel to the edge and keeps the hover fill the width of the button. The library ships no helper for\nit: the padding is the look's own."},"366":{"id":"/docs/components/button-34","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#api","content":"| Part     | Props                                                               | Description                                                                     |\n| -------- | ------------------------------------------------------------------- | ------------------------------------------------------------------------------- |\n| `Button` | `variant`, `size`, `icon`, `busy`, `accessibilityLabel`, `children` | A press that acts; a string child is the label and its name for screen readers. |","table":"table-0"},"367":{"id":"/docs/components/button-35","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#api","content":"| Part         | Props                                                       | Description                                                                     |\n| ------------ | ----------------------------------------------------------- | ------------------------------------------------------------------------------- |\n| `IconButton` | `variant`, `size`, `icon`, `accessibilityLabel`, `children` | A square icon-only button; it will not compile without an `accessibilityLabel`. |","table":"table-0"},"368":{"id":"/docs/components/button-36","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#api","content":"| Part          | Props                                                       | Description                                                                   |\n| ------------- | ----------------------------------------------------------- | ----------------------------------------------------------------------------- |\n| `RoundButton` | `variant`, `size`, `side`, `accessibilityLabel`, `children` | A round icon-only button; `side` is an exact diameter where the scale is off. |","table":"table-0"},"369":{"id":"/docs/components/button-37","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#api","content":"| Part          | Props             | Description                                      |\n| ------------- | ----------------- | ------------------------------------------------ |\n| `SplitButton` | `variant`, `size` | A main action and a menu half in one silhouette. |","table":"table-0"},"370":{"id":"/docs/components/button-38","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#api","content":"| Part                 | Props                                    | Description                                                            |\n| -------------------- | ---------------------------------------- | ---------------------------------------------------------------------- |\n| `SplitButtonSegment` | every `nsh/base` Button prop; `children` | One half; a string child is the label and its name for screen readers. |","table":"table-0"},"371":{"id":"/docs/components/button-39","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#api","content":"| Part                 | Props   | Description                                             |\n| -------------------- | ------- | ------------------------------------------------------- |\n| `SplitButtonDivider` | `style` | The hairline between the main action and the menu half. |","table":"table-0"},"372":{"id":"/docs/components/button-40","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#button","content":"Every prop of `nsh/base` Button passes through. `style`, `hoverStyle`, `activeStyle`, `focusVisibleStyle` and `disabledStyle` go over the look's."},"373":{"id":"/docs/components/button-41","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#button","content":"| Prop      | Type                                                   | Default     |\n| --------- | ------------------------------------------------------ | ----------- |\n| `variant` | `\"default\" \\| \"secondary\" \\| \"ghost\" \\| \"destructive\"` | `\"default\"` |","table":"table-1"},"374":{"id":"/docs/components/button-42","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#button","content":"| Prop   | Type                        | Default     |\n| ------ | --------------------------- | ----------- |\n| `size` | `\"sm\" \\| \"default\" \\| \"lg\"` | `\"default\"` |","table":"table-1"},"375":{"id":"/docs/components/button-43","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#button","content":"| Prop   | Type                | Default |\n| ------ | ------------------- | ------- |\n| `icon` | `IconNode` (lucide) |         |","table":"table-1"},"376":{"id":"/docs/components/button-44","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#button","content":"| Prop   | Type      | Default |\n| ------ | --------- | ------- |\n| `busy` | `boolean` | `false` |","table":"table-1"},"377":{"id":"/docs/components/button-45","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#button","content":"| Prop                 | Type     | Default |\n| -------------------- | -------- | ------- |\n| `accessibilityLabel` | `string` |         |","table":"table-1"},"378":{"id":"/docs/components/button-46","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#button","content":"| Prop       | Type                    | Default |\n| ---------- | ----------------------- | ------- |\n| `children` | `string \\| JSX.Elem