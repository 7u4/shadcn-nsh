---
// The demos' theme, beside the appearance switch: Default (the one the demos are built with) or
// shadcn. A choice goes into the demo app's storage and the panels load again — a running app
// cannot see a later write (`src/lib/palette.ts` says why).
import { PALETTES } from "../../demos/palettes";
import type { Lang } from "../lib/site";
import ToggleGroup from "./ui/ToggleGroup.astro";
import ToggleGroupItem from "./ui/ToggleGroupItem.astro";

export interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const label = lang === "zh-CN" ? "演示主题" : "Demo theme";
---

<ToggleGroup class="palette-switch" variant="segmented" size="xs" aria-label={label} title={label}>
  {PALETTES.map((palette) => (
    <ToggleGroupItem
      data-palette={palette.id}
      aria-label={`${label}: ${palette.label}`}
      on={palette.id === "default"}
    >
      {palette.label}
    </ToggleGroupItem>
  ))}
</ToggleGroup>

<script>
  import { PALETTES } from "../../demos/palettes";
  import { reloadDemos } from "../lib/demo-client";
  import { storePalette, storedPalette } from "../lib/palette";

  for (const group of document.querySelectorAll<HTMLElement>(".palette-switch")) {
    const buttons = [...group.querySelectorAll<HTMLButtonElement>("[data-palette]")];
    const sync = () => {
      const now = storedPalette();
      for (const b of buttons) {
        const on = b.dataset.palette === now;
        b.setAttribute("aria-checked", String(on));
        b.tabIndex = on ? 0 : -1;
      }
    };
    const choose = (id: string) => {
      const palette = PALETTES.find((option) => option.id === id);
      if (!palette) return;
      storePalette(palette.id);
      // A demo reads the palette when it starts: the panels load again with it.
      reloadDemos();
      sync();
    };
    sync();
    group.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-palette]");
      if (button) choose(button.dataset.palette!);
    });
    group.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
      const at = buttons.findIndex((b) => b.dataset.palette === storedPalette());
      const next =
        buttons[(at + (event.key === "ArrowRight" ? 1 : buttons.length - 1)) % buttons.length];
      if (!next) return;
      choose(next.dataset.palette!);
      next.focus();
      event.preventDefault();
    });
  }
</script>

<style is:global>
  .palette-switch {
    flex-shrink: 0;
    margin-right: 0.25rem;
  }
</style>
