---
// The themes the demos can be drawn in, generated from the demos' palette list and each theme's
// own `theme.json`: nothing here names a theme of its own (`src/lib/themes.ts` reads both).
// `check:pages` holds the registry items to the same list.
import DemoFrame from "../../components/DemoFrame.astro";
import Button from "../../components/ui/Button.astro";
import Docs from "../../layouts/Docs.astro";
import { themePages } from "../../lib/themes";

const themes = themePages();
---

<Docs
  title="Themes"
  description="The palettes the demos can draw in: their names, how to install each one, and every role it sets."
>
  <h2 id="themes">One look, more than one palette</h2>
  <p>
    A theme is one <code>AppTheme</code>: <code>theme.json</code> (colors and radii),
    <code>finishes.json</code> (gradients and shadows) and the <code>index.ts</code> that names it.
    An app is <em>built</em> with one theme and can <em>carry</em> more, switching between them
    while it runs with <code>selectTheme</code>.
  </p>
  <p>
    Every demo on this site can be drawn in either palette: pick one with the{" "}
    <strong>Demo theme</strong> switch in the nav, and the previews load again in it. The list is
    <code>apps/docs/demos/palettes.ts</code>; this page is generated from it and from each theme's
    own <code>theme.json</code>.
  </p>

  <h2 id="showcase">The showcase</h2>
  <p>
    The usual controls — buttons, a card with a field, badges, switches, a slider and a meter —
    drawn in the palette the nav chose, with the card, inset and press finishes it brings.
  </p>
  <DemoFrame name="themes" />

  {themes.map((theme) => (
    <section data-theme={theme.palette.id}>
      <h2 id={`theme-${theme.palette.id}`}>{theme.name}</h2>
      <p>{theme.palette.description}</p>
      <p>
        The switch calls it <strong>{theme.palette.label}</strong>; the registry item is
        <code>{theme.item}</code>.{" "}
        <Button data-show-theme={theme.palette.id} variant="outline" size="sm">
          Show it in the showcase
        </Button>
      </p>

      <h3 id={`install-${theme.palette.id}`}>Installation</h3>
      <pre><code>npx shadcn-nsh@latest add {theme.item}</code></pre>
      <p>
        <code>add {theme.item}</code> installs <code>themes/{theme.palette.id}/</code> beside the
        app's build-time theme and leaves that one as it is; the app lists the theme and calls
        <code>selectTheme</code> to switch to it. To build the app on this theme instead, run
        <code>init --theme {theme.palette.id}</code> (or{" "}
        <code>init --theme {theme.palette.id} --overwrite</code> on an app that already has one
        theme).
        {theme.palette.id === "default" ? (
          <>
            {" "}
            The build-time theme is the <code>theme</code> item that <code>init</code> writes
            without a flag; this item is the same data, for an app built on another theme to switch
            back to.
          </>
        ) : null}
      </p>

      <h3 id={`roles-${theme.palette.id}`}>Roles</h3>
      <p>
        Every role the theme sets, in <code>theme.json</code>'s order, for light and dark: the
        swatch draws the value and the text is what the file writes. A <code>var(--x)</code> or a
        <code>color-mix()</code> is the theme's own reference; the swatch fills it in from the same
        appearance, the text leaves it as written.
      </p>
      <div class="theme-roles">
        <table>
          <thead>
            <tr>
              <th>Role</th>
              <th>Light</th>
              <th>Dark</th>
            </tr>
          </thead>
          <tbody>
            {theme.roles.map((role) => (
              <tr>
                <td>
                  <code>{role.role}</code>
                </td>
                <td class="theme-roles__cell">
                  <span class="theme-roles__swatch" aria-hidden="true">
                    <span class="theme-roles__fill" style={{ backgroundColor: role.lightSwatch }} />
                  </span>
                  <code>{role.light}</code>
                </td>
                <td class="theme-roles__cell">
                  <span class="theme-roles__swatch" aria-hidden="true">
                    <span class="theme-roles__fill" style={{ backgroundColor: role.darkSwatch }} />
                  </span>
                  <code>{role.dark}</code>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}
</Docs>

<script>
  import { PALETTES } from "../../../demos/palettes";
  import { choosePalette } from "../../lib/palette";

  const showcase = document.getElementById("showcase");

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-show-theme]")) {
    button.addEventListener("click", () => {
      const palette = PALETTES.find((option) => option.id === button.dataset.showTheme);
      if (!palette) return;
      choosePalette(palette.id);
      showcase?.scrollIntoView({ block: "start" });
    });
  }
</script>

<style is:global>
  .theme-roles table {
    display: table;
    width: 100%;
    table-layout: fixed;
  }
  .theme-roles :is(th, td) {
    vertical-align: middle;
  }
  .theme-roles :is(th, td):first-child {
    width: 9.5rem;
  }
  .theme-roles :is(th, td):last-child {
    min-width: 0;
  }
  .theme-roles td code {
    white-space: normal;
    overflow-wrap: anywhere;
    font-size: 0.78rem;
  }
  /* The color over a faint checker, so a translucent value shows what it is. */
  .theme-roles__swatch {
    position: relative;
    display: inline-block;
    width: 1.25rem;
    height: 1.25rem;
    margin-right: 0.5rem;
    overflow: hidden;
    vertical-align: middle;
    border: 1px solid var(--border);
    border-radius: 6px;
    background-color: var(--card);
    background-image:
      linear-gradient(45deg, var(--line) 25%, transparent 25%),
      linear-gradient(-45deg, var(--line) 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, var(--line) 75%),
      linear-gradient(-45deg, transparent 75%, var(--line) 75%);
    background-size: 8px 8px;
    background-position:
      0 0,
      0 4px,
      4px -4px,
      -4px 0;
  }
  .theme-roles__fill {
    position: absolute;
    inset: 0;
  }
</style>
