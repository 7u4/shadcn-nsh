---
import Docs from "../../../layouts/Docs.astro";
import { withBase } from "../../../lib/base";
import { components } from "../../../lib/components";
import { KIND_LABELS, KINDS } from "../../../lib/kinds";

const byKind = KINDS.map((kind) => ({
  kind,
  label: KIND_LABELS[kind],
  items: components.filter((c) => c.kind === kind),
})).filter((group) => group.items.length > 0);
---

<Docs
  title="Components"
  description="Copy-into-app components for Native Shell, built on nsh/base."
>
  <p>
    {components.length} components, one page each: Installation, Usage, Examples and API. They are
    grouped in two: <strong>Official</strong>, aligned with a shadcn/ui component, and
    <strong>Our own</strong>, this library's additions with no shadcn/ui counterpart (an NSH element
    wrapped in the theme counts as ours). Behavior, keyboard support and the full unstyled props
    live on <a href="https://nsh.dev/elements">nsh.dev/elements</a>; each page links its base
    element and the shadcn/ui component it stands in for.
  </p>
  <p>
    The list is generated from <code>registry.json</code> and these pages, so every{" "}
    <code>registry:ui</code> item has a page and every page has an item. The group comes from{" "}
    <a href={withBase("docs/components/coverage")}>Coverage</a>: a page registered in one of its
    shadcn/ui rows is Official, one in none is Our own. Add one with{" "}
    <code>npx shadcn-nsh@latest add &lt;name&gt;</code>.
  </p>
  {byKind.map((group) => (
    <>
      <h2 id={group.kind}>{group.label}</h2>
      <ul>
        {group.items.map((c) => (
          <li>
            <a href={withBase(`docs/components/${c.slug}`)}>{c.title}</a>
            <span style="color: var(--muted-foreground)"> — {c.description}</span>
          </li>
        ))}
      </ul>
    </>
  ))}
</Docs>
