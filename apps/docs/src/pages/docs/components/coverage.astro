---
import Docs from "../../../layouts/Docs.astro";
import { withBase } from "../../../lib/base";
import { components } from "../../../lib/components";
import {
  NSH_ELEMENTS,
  SHADCN_UI,
  nshElementUrl,
  shadcnUrl,
  stateOf,
  type OfficialEntry,
  type OfficialState,
} from "../../../lib/official";

const pages = new Set(components.map((component) => component.slug));
const titleOf = new Map(components.map((component) => [component.slug, component.title]));

const STATE_LABELS: Record<OfficialState, string> = {
  covered: "Covered",
  planned: "Planned",
  missing: "Missing",
  "not-doing": "Not doing",
  primitive: "Primitive",
};

/** Green when nothing is asked of this library, yellow for a gap still open, red for never. */
const DOT: Record<OfficialState, string> = {
  covered: "yes",
  primitive: "yes",
  planned: "partial",
  missing: "partial",
  "not-doing": "no",
};

type Row = { entry: OfficialEntry; state: OfficialState; served: string[] };

const rows = (entries: readonly OfficialEntry[]): Row[] =>
  entries.map((entry) => ({
    entry,
    state: stateOf(entry, pages),
    served: entry.ours.filter((slug) => pages.has(slug)),
  }));

const tally = (list: Row[]) => {
  const counts = new Map<OfficialState, number>();
  for (const row of list) counts.set(row.state, (counts.get(row.state) ?? 0) + 1);
  return [...counts].map(([state, n]) => `${n} ${STATE_LABELS[state].toLowerCase()}`);
};

const shadcnRows = rows(SHADCN_UI);
const nshBaseRows = rows(NSH_ELEMENTS.filter((entry) => entry.group === "base"));
const nshPrimitiveRows = rows(NSH_ELEMENTS.filter((entry) => entry.group === "primitives"));
---

<Docs
  title="Coverage"
  description="Every shadcn/ui component and every NSH element, and what this library has for it."
>
  <p>
    Two official sets are worth answering for: the
    <a href="https://ui.shadcn.com/docs/components">shadcn/ui components</a>, whose parts and API
    names this library follows, and the <a href="https://nsh.dev/elements">NSH elements</a> it is
    built on. Each table lists every component of theirs and where it went here: a page under
    another name counts, and a row with no page says why there is none.
  </p>
  <p>
    This page is generated from <code>apps/docs/src/lib/official.ts</code>; do not edit it. Add a
    component there and in <code>apps/docs/src/lib/kinds.ts</code>, then run
    <code>bun run docs:components</code>. <code>bun run check:pages</code> fails when an official
    component has no row, when a row names a page that does not exist, and when a row serves nothing
    without saying why.
  </p>

  <h2 id="shadcn-ui">shadcn/ui</h2>
  <p>
    {shadcnRows.length} components: {tally(shadcnRows).join(", ")}. A renamed one shows the rename
    in the second column — <code>dropdown-menu</code> is <code>menu</code>, <code>sonner</code> is
    <code>toast</code>, <code>chart</code> is <code>plot</code>.
  </p>
  <table>
    <thead>
      <tr>
        <th>shadcn/ui</th>
        <th>Here</th>
        <th>State</th>
      </tr>
    </thead>
    <tbody>
      {shadcnRows.map(({ entry, state, served }) => (
        <tr>
          <td>
            <a href={shadcnUrl(entry.id)} rel="noopener noreferrer">
              {entry.id}
            </a>
          </td>
          <td>
            {served.length === 0
              ? "—"
              : served.map((slug, index) => (
                  <>
                    {index > 0 ? ", " : null}
                    <a href={withBase(`docs/components/${slug}`)}>{titleOf.get(slug)}</a>
                  </>
                ))}
          </td>
          <td>
            <span class={`status status--${DOT[state]}`}></span>
            {STATE_LABELS[state]}
            {entry.note ? (
              <>
                {" "}
                — <span class="muted">{entry.note}</span>
              </>
            ) : null}
          </td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2 id="nsh-base">NSH base</h2>
  <p>
    {nshBaseRows.length} elements of <code>nsh/base</code>: {tally(nshBaseRows).join(", ")}. One
    element can give more than one page — <code>menu</code> also gives the context menu and the menu
    bar, <code>button</code> the pressable.
  </p>
  <table>
    <thead>
      <tr>
        <th>NSH</th>
        <th>Here</th>
        <th>State</th>
      </tr>
    </thead>
    <tbody>
      {nshBaseRows.map(({ entry, state, served }) => (
        <tr>
          <td>
            <a href={nshElementUrl(entry.id)} rel="noopener noreferrer">
              {entry.id}
            </a>
          </td>
          <td>
            {served.length === 0
              ? "—"
              : served.map((slug, index) => (
                  <>
                    {index > 0 ? ", " : null}
                    <a href={withBase(`docs/components/${slug}`)}>{titleOf.get(slug)}</a>
                  </>
                ))}
          </td>
          <td>
            <span class={`status status--${DOT[state]}`}></span>
            {STATE_LABELS[state]}
            {entry.note ? (
              <>
                {" "}
                — <span class="muted">{entry.note}</span>
              </>
            ) : null}
          </td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2 id="nsh-primitives">NSH primitives</h2>
  <p>
    {nshPrimitiveRows.length} primitives: {tally(nshPrimitiveRows).join(", ")}. These are the
    elements every component is drawn with; an app uses them directly, and this library wraps none
    of them.
  </p>
  <table>
    <thead>
      <tr>
        <th>NSH</th>
        <th>Here</th>
        <th>State</th>
      </tr>
    </thead>
    <tbody>
      {nshPrimitiveRows.map(({ entry, state }) => (
        <tr>
          <td>
            <a href={nshElementUrl(entry.id)} rel="noopener noreferrer">
              {entry.id}
            </a>
          </td>
          <td>—</td>
          <td>
            <span class={`status status--${DOT[state]}`}></span>
            {STATE_LABELS[state]}
            {entry.note ? (
              <>
                {" "}
                — <span class="muted">{entry.note}</span>
              </>
            ) : null}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</Docs>
